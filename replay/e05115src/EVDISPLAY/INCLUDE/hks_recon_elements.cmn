***********************************************************************
*     CTPTYPE=parm
*
      integer*4        hmax_recon_elements
      parameter       (hmax_recon_elements = 1000) 
      integer*4        hmax_t2s_elements
      parameter       (hmax_t2s_elements = 500) 
*!Max # coeff elements

      real*4           h_recon_coeff(4,hmax_recon_elements)
      real*4           h_ang_slope_x,h_ang_slope_y
      real*4           h_ang_offset_x,h_ang_offset_y
      real*4           h_det_offset_x,h_det_offset_y
      real*4           h_z_true_focus 
*! Z position of HKS focus
      integer*4        h_recon_expon(5,hmax_recon_elements)
      integer*4        h_num_recon_terms
      integer*4        h_recon_initted
*	Target to Sieve Slit transter matrix      
      integer*4        h_num_t2s_terms	
      integer*4        h_t2s_initted
      integer*4        h_t2s_expon(3,hmax_t2s_elements)
      real*4           h_t2s_coeff(2,hmax_t2s_elements)
		real*4           Center_of_hfp(4)
		real*4           Nfactor_of_hfp(4)
		real*4           Center_of_htar(4)
		real*4           Nfactor_of_htar(4)

* add reconstruction option
* 0(default)= ERIKA fit / 1=RAYTRACE matrix fit
      Integer*4        h_recon_switch

*     h_recon_initted,             !Initialization flag.
*     h_num_recon_terms,           !Number of terms.
*     h_recon_coeff,               !Coefficients.
*     h_recon_expon,               !Exponents.
*     h_ang_slope_x, s_ang_slope_y,   ! Slopes for rotation of f plane
*     h_ang_offset_x, s_ang_offset_y, ! Slopes for rotation of f plane
*     h_det_offset_x,s_det_offset_y,  ! Detector offsets
*     h_z_true_focus               ! Z position of HKS focus


      common /hks_recon_elements/
     >     h_recon_switch,             
     >     h_recon_initted,             
     >     h_num_recon_terms,          
     >     h_num_t2s_terms,          
     >     h_recon_coeff,             
     >     h_recon_expon,              
     >     h_ang_slope_x, h_ang_slope_y,   
     >     h_ang_offset_x, h_ang_offset_y,
     >     h_det_offset_x,h_det_offset_y, 
     >     h_z_true_focus,          
     >     h_t2s_initted,            ! Target to SV matrix            
     >     h_t2s_coeff,             
     >     h_t2s_expon,               
     >	  Center_of_hfp,
     >	  Nfactor_of_hfp,
     >	  Center_of_htar,
     >	  Nfactor_of_htar

************************************************************************



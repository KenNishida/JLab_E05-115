*     hks_geometry.cmn
*
*     This include file has all the geometrical coefficients for the
*     HKS wire chambers.
*
*     d.f. geesaman        1 September 1993
*     
*     modifed    dfg       14 Feb 1994
*                change SLAYER_PARAM(2,)  to sdc_zpos
*                change SLAYER_PARAM(3,)  to sdc_alpha_angle
*                change SLAYER_PARAM(4,)  to sdc_beta_angle
*                change SLAYER_PARAM(5,)  to sdc_gamma_angle
*                change SLAYER_PARAM(6,)  to sdc_pitch
*                change SLAYER_PARAM(7,)  to sdc_nrwire
*                change SLAYER_PARAM(8,)  to sdc_central_wire
*                change SLAYER_PARAM(9,)  to sdc_sigma
*                change SLAYER_LABEL      to sdc_layer_name
*                add     sdc_xcenter
*                        sdc_ycenter
* $Log: hks_geometry.cmn,v $
* Revision 1.1.1.1  2009/06/23 13:55:43  kawama
*
* e05115 src repository for software development
*
* Revision 1.1.1.1  2005/05/14 21:44:37  miyoshi
*
*
* Revision 1.3  2005/03/01 23:51:06  miyoshi
* add hdc wire offset
*
* Revision 1.2  2004/12/24 21:18:50  miyoshi
* change name plane to layer
*
* Revision 1.1.1.1  2004/08/30 21:21:38  miyoshi
* new dir
*
*
* Revision 1.9 2004/03/02 Miyoshi
* for E01-011
* Revision 1.8  1996/09/04 16:28:21  saw
* (JRA) Make hdc_nrwire integer
*
* Revision 1.7  1995/05/22 19:07:14  cdaq
* (SAW) Split gen_data_data_structures into gen, hms, hks, and coin parts
*
* Revision 1.6  1995/01/27  20:21:25  cdaq
* (JRA) Remove no longer used drift time->distance parameters
*
* Revision 1.5  1994/11/22  18:44:30  cdaq
* (SPB) Brought up to date with hms_geometry.cmn
* (SAW) Cleaned up ?DC_NUM_CHAMBERS and ?MAX_NUM_CHAMBERS stuff
*
* Revision 1.4  1994/08/05  20:36:42  cdaq
* * (SAW) Add makereg directive with required include files
*         Add "CTPTYPE=parm" directive for auto generation of CTP reg calls
*
* Revision 1.3  1994/06/14  03:23:06  cdaq
* (DFG) Add sdc_layer_time_zero
*
* Revision 1.2  1994/03/24  18:37:29  cdaq
* (DFG) Additional parameters
*
* Revision 1.1  1994/02/22  14:47:24  cdaq
* Initial revision
*                    
*     The following include statments must precede the inclusion of this
*     file in each routine that uses it.  The *%% syntax is also a
*     directive to makereg to tell it to include the code in the program
*     that it generates.
*
*%%   include 'hks_data_structures.cmn'
*
*     CTPTYPE=parm             
*     Probably don't really want the following registered
*
      real*4 hzchi,hzpsi       
*! geometrical coefficients defining z-z0
      real*4 hxchi,hxpsi       
*! x and y for each wire layer. 
      real*4 hychi,hypsi
*
      real*4 hz0               
*! z coordinate of intersection of chamber with
                               ! z axis
      real*4 hpsi0,hchi0,hphi0 
*! psi, chi and phi  coordinates  where a 
                               ! chamber normal passing through the origin
                               ! intersects the chamber. Used in stub fits

*     number of layer track fit coefficients
      integer*4 HNUM_LAYER_COEFF
      parameter (HNUM_LAYER_COEFF=9)
*      number of ray parameters
      integer*4 HNUM_RAY_PARAM
      parameter (HNUM_RAY_PARAM=4)
*      
      real*4 hstubcoef(HMAX_NUM_DC_LAYERS,HNUM_RAY_PARAM)
*! coefficents used in stub fits
                               ! note these contain one power of sigma

      real*4 htanbeta,hsinbeta,hcosbeta
*
      real*4 hxsp              
*! coefficents used in space point fits.
      real*4 hysp
*
      real*8 hlayer_coeff(HNUM_LAYER_COEFF,HMAX_NUM_DC_LAYERS)      
*! coefficients used in final track fit
*
*
      common/HKS_GEOMETRY/
     &     hlayer_coeff,
     &     hzpsi(HMAX_NUM_DC_LAYERS),hzchi(HMAX_NUM_DC_LAYERS),
     &     hxpsi(HMAX_NUM_DC_LAYERS),hxchi(HMAX_NUM_DC_LAYERS),
     &     hypsi(HMAX_NUM_DC_LAYERS),hychi(HMAX_NUM_DC_LAYERS),
     &     hz0(HMAX_NUM_DC_LAYERS),hpsi0(HMAX_NUM_DC_LAYERS),
     &     hchi0(HMAX_NUM_DC_LAYERS),hphi0(HMAX_NUM_DC_LAYERS),
     &     hstubcoef,
     &     hxsp(HMAX_NUM_DC_LAYERS),hysp(HMAX_NUM_DC_LAYERS),
     &     htanbeta(HMAX_NUM_DC_LAYERS),hsinbeta(HMAX_NUM_DC_LAYERS),
     &     hcosbeta(HMAX_NUM_DC_LAYERS)
*
      real*4    hdc_zpos
      real*4    hdc_alpha_angle
      real*4    hdc_beta_angle
      real*4    hdc_gamma_angle
      real*4    hdc_pitch
      integer*4 hdc_nrwire(HMAX_NUM_DC_LAYERS)
      real*4    hdc_central_wire
      real*4    hdc_sigma

      real*4    hdc_xcenter(HMAX_NUM_DC_LAYERS)

      real*4    hdc_ycenter(HMAX_NUM_DC_LAYERS)

      real*4    hdc_center

      real*4 hdc_length_x,hdc_length_y

*      real*4 HLAYER_PARAM
      integer*4 hdc_chamber_layers
      character*16 hdc_layer_name
      common/HKS_LAYER_PARAMETERS/
     &     hdc_zpos(HMAX_NUM_DC_LAYERS),
     &     hdc_alpha_angle(HMAX_NUM_DC_LAYERS),
     &     hdc_beta_angle(HMAX_NUM_DC_LAYERS),
     &     hdc_gamma_angle(HMAX_NUM_DC_LAYERS),
     &     hdc_pitch(HMAX_NUM_DC_LAYERS),
     &     hdc_central_wire(HMAX_NUM_DC_LAYERS),
     &     hdc_nrwire,
     &     hdc_sigma(HMAX_NUM_DC_LAYERS),
     &     hdc_xcenter,
     &     hdc_ycenter,
     &     hdc_chamber_layers(HMAX_NUM_DC_LAYERS),
     &     hdc_layer_name(HMAX_NUM_DC_LAYERS),
     &     hdc_center(HMAX_NUM_DC_LAYERS),
     &     hdc_length_x,
     &     hdc_length_y

      real*4 hlocrayzt
      parameter (hlocrayzt=0.)
*
*     CTPTYPE=parm
*
*     parameter file variables. Separate by type to make it easy to add
*     at the end
*     REAL*4
*
*      real*4 hdrift_velocity        ! hks drift velocity in cm/ns
      real*4 hdc_tdc_time_per_channel
      real*4 hdc_1_zpos
      real*4 hdc_2_zpos
      real*4 hdc_3_zpos
      real*4 hdc_layer_time_zero
      common/HKS_CHAMBER_READOUT_REAL/
*     &     hdrift_velocity,
     &     hdc_tdc_time_per_channel,
     &     hdc_1_zpos,
     &     hdc_2_zpos,
     &     hdc_3_zpos,
     &     hdc_layer_time_zero(HMAX_NUM_DC_LAYERS)
*
*    INTEGER*4
*
      integer*4 hdc_wire_counting(HMAX_NUM_DC_LAYERS)
*     ! readout numbering order
*
      common/HKS_CHAMBER_READOUT_INT/
     &     hdc_wire_counting

*
*     CTPTYPE=parm
*
*     WIRE OFFSET. HDC has wires not reading out.
*     All the wires which can be read out is counted.
*     For example, wire number at layer 1 starts from 3.
*
      INTEGER*4 HDC_WIRE_OFFSET_LOW
      INTEGER*4 HDC_WIRE_OFFSET_HIGH
 
      COMMON/HKS_HDC_WIRE_OFFSET/
     1     HDC_WIRE_OFFSET_LOW(HMAX_NUM_DC_LAYERS),
     2     HDC_WIRE_OFFSET_HIGH(HMAX_NUM_DC_LAYERS)



*%%   include "hks_data_structures.cmn"
*
*     
*     CTPTYPE=event
*     
*     Event varaibles to calculate
      REAL*4 HHELAS_COR                 
*     ! Difference between momentum measured
                                ! by tracking and elastic kinematics
      COMMON/HKS_PHYSICS_SING/
     &     HHELAS_COR
*     
*     CTPTYPE=parm
*     
*     initializiation paramters
      REAL*4  HPHYSICSA                 
*     Coefficients of p3 in elastic cal
      REAL*4  HPHYSICSB                 
      REAL*4  HPHYSICAB2                
      REAL*4  HPHYSICSM3B               
      REAL*4  COSHTHETAS                
*     COS(HTHETA_LAB)
      REAL*4  SINHTHETAS                
*     SIN(HTHETA_LAB)
      COMMON/HKS_PHYSICS_PARAM_R4/
     &     HPHYSICSA,
     &     HPHYSICSB,
     &     HPHYSICAB2,
     &     HPHYSICSM3B,
     &     COSHTHETAS,
     &     SINHTHETAS
*     
*     Parameters that select the best track. Note these should be
*     loose cuts to make sure we select one track. The final 
*     tighter cuts should be made with tests.
      REAL*4 hsel_chi2_fpperdegmax      
*     ! Maximun chi2 per degree of freedom
                                ! at the focal plane
      REAL*4 hsel_dedx1min              
*     ! Minimum dedx in chamber 1
      REAL*4 hsel_dedx1max              
*     ! Maximum dedx in chamber 1
      REAL*4 hsel_betamin               
*     ! Minimum beta 
      REAL*4 hsel_betamax               
*     ! Maximum beta
      REAL*4 hsel_etmin                 
*     ! Minimum track et
      REAL*4 hsel_etmax                 
*     ! Maximum track et
      INTEGER*4 hsel_ndegreesmin        
*     ! Minimum number of degrees of freedom
*     
      COMMON/hks_chose_one_track_r4/
     &     hsel_chi2_fpperdegmax,
     &     hsel_dedx1min,
     &     hsel_dedx1max,
     &     hsel_betamin,
     &     hsel_betamax,
     &     hsel_etmin,
     &     hsel_etmax
*     
      COMMON/hks_chose_one_track_i4/
     &     hsel_ndegreesmin      
      
*     
*     CTPTYPE=event
*     
      real*4 hsx_dc1(HNPHYSICS_MAX)
      real*4 hsy_dc1(HNPHYSICS_MAX)
      real*4 hsx_dc2(HNPHYSICS_MAX)
      real*4 hsy_dc2(HNPHYSICS_MAX)
      real*4 hsx_s1x(HNPHYSICS_MAX)
      real*4 hsy_s1x(HNPHYSICS_MAX)
      real*4 hsx_s1y(HNPHYSICS_MAX)
      real*4 hsy_s1y(HNPHYSICS_MAX)
      real*4 hsx_s2x(HNPHYSICS_MAX)
      real*4 hsy_s2x(HNPHYSICS_MAX)

      real*4 hsx_aer(HNPHYSICS_MAX,HNUM_AER_LAYERS)
      real*4 hsy_aer(HNPHYSICS_MAX,HNUM_AER_LAYERS)
      real*4 hsx_wat(HNPHYSICS_MAX,HNUM_WAT_LAYERS)
      real*4 hsy_wat(HNPHYSICS_MAX,HNUM_WAT_LAYERS)
      real*4 hsx_luc(HNPHYSICS_MAX,HNUM_LUC_LAYERS)
      real*4 hsy_luc(HNPHYSICS_MAX,HNUM_LUC_LAYERS)

      Real*4 hsaer_npe(HNPHYSICS_MAX,HNUM_AER_LAYERS)
      Real*4 hswat_npe(HNPHYSICS_MAX,HNUM_WAT_LAYERS)
      Real*4 hswat_npe_k_ratio(HNPHYSICS_MAX,HNUM_WAT_LAYERS)
      Real*4 hsluc_npe(HNPHYSICS_MAX,HNUM_LUC_LAYERS)	
      
      Real*4 hsaer_npe2(HNPHYSICS_MAX,HNUM_AER_LAYERS)
      Real*4 hswat_npe2(HNPHYSICS_MAX,HNUM_WAT_LAYERS)
      Real*4 hswat_npe_k_ratio2(HNPHYSICS_MAX,HNUM_WAT_LAYERS)
      Real*4 hsluc_npe2(HNPHYSICS_MAX,HNUM_LUC_LAYERS)
      
      Real*4 hsaer_time(HNPHYSICS_MAX,HNUM_AER_LAYERS)
      Real*4 hswat_time(HNPHYSICS_MAX,HNUM_WAT_LAYERS)
      Real*4 hsluc_time(HNPHYSICS_MAX,HNUM_LUC_LAYERS)	

      Real*4 hsaer_time2(HNPHYSICS_MAX,HNUM_AER_LAYERS)
      Real*4 hswat_time2(HNPHYSICS_MAX,HNUM_WAT_LAYERS)
      Real*4 hsluc_time2(HNPHYSICS_MAX,HNUM_LUC_LAYERS)

      Real*4 hsaer_npe_pos(HNPHYSICS_MAX,HNUM_AER_LAYERS)
      Real*4 hswat_npe_pos(HNPHYSICS_MAX,HNUM_WAT_LAYERS)
      Real*4 hsluc_npe_pos(HNPHYSICS_MAX,HNUM_LUC_LAYERS)	
      
      Real*4 hsaer_npe_pos2(HNPHYSICS_MAX,HNUM_AER_LAYERS)
      Real*4 hswat_npe_pos2(HNPHYSICS_MAX,HNUM_WAT_LAYERS)
      Real*4 hsluc_npe_pos2(HNPHYSICS_MAX,HNUM_LUC_LAYERS)
      
      Real*4 hsaer_time_pos(HNPHYSICS_MAX,HNUM_AER_LAYERS)
      Real*4 hswat_time_pos(HNPHYSICS_MAX,HNUM_WAT_LAYERS)
      Real*4 hsluc_time_pos(HNPHYSICS_MAX,HNUM_LUC_LAYERS)	

      Real*4 hsaer_time_pos2(HNPHYSICS_MAX,HNUM_AER_LAYERS)
      Real*4 hswat_time_pos2(HNPHYSICS_MAX,HNUM_WAT_LAYERS)
      Real*4 hsluc_time_pos2(HNPHYSICS_MAX,HNUM_LUC_LAYERS)


      Real*4 hsaer_npe_neg(HNPHYSICS_MAX,HNUM_AER_LAYERS)
      Real*4 hswat_npe_neg(HNPHYSICS_MAX,HNUM_WAT_LAYERS)
      Real*4 hsluc_npe_neg(HNPHYSICS_MAX,HNUM_LUC_LAYERS)	
      
      Real*4 hsaer_npe_neg2(HNPHYSICS_MAX,HNUM_AER_LAYERS)
      Real*4 hswat_npe_neg2(HNPHYSICS_MAX,HNUM_WAT_LAYERS)
      Real*4 hsluc_npe_neg2(HNPHYSICS_MAX,HNUM_LUC_LAYERS)
      
      Real*4 hsaer_time_neg(HNPHYSICS_MAX,HNUM_AER_LAYERS)
      Real*4 hswat_time_neg(HNPHYSICS_MAX,HNUM_WAT_LAYERS)
      Real*4 hsluc_time_neg(HNPHYSICS_MAX,HNUM_LUC_LAYERS)	

      Real*4 hsaer_time_neg2(HNPHYSICS_MAX,HNUM_AER_LAYERS)
      Real*4 hswat_time_neg2(HNPHYSICS_MAX,HNUM_WAT_LAYERS)
      Real*4 hsluc_time_neg2(HNPHYSICS_MAX,HNUM_LUC_LAYERS)
      
      integer*4 hsscin_elem_hit(HNPHYSICS_MAX,4)
      Real*4 hsaer_num(HNPHYSICS_MAX,HNUM_AER_LAYERS)
      Real*4 hswat_num(HNPHYSICS_MAX,HNUM_WAT_LAYERS)
      Real*4 hsluc_num(HNPHYSICS_MAX,HNUM_LUC_LAYERS)

      COMMON/hks_tmp_stuff/
     &     hsx_dc1, hsy_dc1,
     &     hsx_dc2, hsy_dc2,
     &     hsx_s1x, hsy_s1x,
     &     hsx_s1y, hsy_s1y,
     &     hsx_s2x, hsy_s2x,
     &     hsx_aer,hsy_aer,
     &     hsx_wat,hsy_wat,
     &     hsx_luc,hsy_luc,
     &     hsaer_npe,hswat_npe,hswat_npe_k_ratio,hsluc_npe,
     &     hsaer_npe2,hswat_npe2,hswat_npe_k_ratio2,hsluc_npe2,
     &     hsaer_time,hswat_time,hsluc_time,
     &     hsaer_time2,hswat_time2,hsluc_time2,
     &     hsaer_npe_pos,hswat_npe_pos,hsluc_npe_pos,
     &     hsaer_npe_pos2,hswat_npe_pos2,hsluc_npe_pos2,
     &     hsaer_time_pos,hswat_time_pos,hsluc_time_pos,
     &     hsaer_time_pos2,hswat_time_pos2,hsluc_time_pos2,
     &     hsaer_npe_neg,hswat_npe_neg,hsluc_npe_neg,
     &     hsaer_npe_neg2,hswat_npe_neg2,hsluc_npe_neg2,
     &     hsaer_time_neg,hswat_time_neg,hsluc_time_neg,
     &     hsaer_time_neg2,hswat_time_neg2,hsluc_time_neg2,
     &     hsscin_elem_hit,
     &     hsaer_num,
     &     hswat_num,
     &     hsluc_num
*
*     CTPTYPE=parm
*
      real*4 hpathlength_central
*     - coeff up to 5th order
*     (x,y) x = xfp,yfp,xpfp,ypfp
*           y = 1st,2nd,3rd,4th,5th order
      real*4 hpath_coeff(4,5)
      
*
*     CTPTYPE=event
*
      real*4 hsbeta_k(HNPHYSICS_MAX)
      real*4 hsbeta_e(HNPHYSICS_MAX)
      real*4 hsbeta_pi(HNPHYSICS_MAX)
      real*4 hsbeta_pr(HNPHYSICS_MAX)
      real*4 hspathlength(HNPHYSICS_MAX)

      COMMON/hks_timing_stuff/
     &     hpathlength_central,
     &     hsbeta_k,
     &     hsbeta_e,
     &     hsbeta_pi,
     &     hsbeta_pr,
     &     hspathlength,
     &     hpath_coeff
*     
*     CTPTYPE=event
*     
      real*4 sqx,sqy,sqz,sqabs
      real*4 sinvmass
      
      common/hks_physics_quantaties/
     &     sqx,sqy,sqz,sqabs,
     &     sinvmass
      
      
c------------------------------------------------------------------
c     For photodisintegration calculations.
c     M.Miller, NPL UIUC, 10-Sept-1995, miller5@uiuc.edu
*     
*     CTPTYPE=parm
*     
      real*4 hphoto_mtarget    
*     ! Mass of target [Gev/c^2]
      real*4 hphoto_mrecoil    
*     ! Mass of recoil system [Gev/c^2]
*     
*     CTPTYPE=event
*     
      real*4 hsegamma
      real*4 hsegamma_p
      
      common /hks_photo_param/
     &     hphoto_mtarget,
     &     hphoto_mrecoil,
     &     hsegamma,
     &     hsegamma_p
      
*     
*     CTPTYPE=parm
*
c     D.Dutta, 24th-Apr-1996
      
      real*4 hdelta_offset     
*     ! hms delta offset
      real*4 htheta_offset     
*     ! hms scatteringangel offset
      real*4 hphi_offset
      real*4 hmomentum_factor    
*     ! multiplier for the hms momentum
      
      COMMON /hks_offsets/
     &     hdelta_offset,
     &     htheta_offset,
     &     hphi_offset,
     &     hmomentum_factor
*     
*     CTPTYPE=event
*     
      real*4 hs_qvec(HNPHYSICS_MAX,4)   
      real*4 hs_kpvec(HNPHYSICS_MAX,4) 
      real*4 hs_kvec(HNPHYSICS_MAX,4)  
      real*4 hs_tvec(HNPHYSICS_MAX,4)
      
      COMMON/hs_vectors/
     &     hs_qvec,
     &     hs_kpvec,
     &     hs_kvec,
     &     hs_tvec



      subroutine c_Ntuple_keep(ABORT,err)
*----------------------------------------------------------------------
*     
*     Purpose : Add entry to the COIN Ntuple
*     
*     Output: ABORT      - success or failure
*     : err        - reason for failure, if any
*     
*     Created: 11-Apr-1994  K.B.Beard, Hampton U.
*     Modified: 11-Oct-1999 Jinghua Liu for HNSS
*     
*     Revision 2.2 2009/08/11 Z. Ye
*     change for E05-115: Add Lucite to the end of the list
*
*     Revision 2.1 2004/03/02 Miyoshi
*     change for E01-011
*     
*     Revision 2.0  1999/10/11 17:20:09  jinghua
*     (JLiu) Change to HNSS
*     
*     Revision 1.9  1999/02/23 16:41:08  csa
*     Variable changes
*     
*     Revision 1.8  1996/09/04 15:30:17  saw
*     (JRA) Modify ntuple contents
*     
*     Revision 1.7  1996/04/29 18:44:04  saw
*     (JRA) Add aerogel photon count
*     
*     Revision 1.6  1996/01/22 15:06:41  saw
*     (JRA) Change ntuple contents
*     
*     Revision 1.5  1996/01/16 21:01:33  cdaq
*     (JRA) Add HSDELTA and SSDELTA
*     
*     Revision 1.4  1995/09/01 15:45:21  cdaq
*     (JRA) Add spectrometer kinematic vars to ntuple
*     
*     Revision 1.3  1995/05/22  20:50:43  cdaq
*     (SAW) Split gen_data_data_structures into gen, hms, sos, 
*     and coin parts"
*     
*     Revision 1.2  1994/06/17  02:41:25  cdaq
*     (KBB) Upgrade
*     
*     Revision 1.1  1994/04/12  16:12:33  cdaq
*     Initial revision
*     
*     
*----------------------------------------------------------------------
      implicit none
      save
*     
      character*13 here
      parameter (here='c_Ntuple_keep')
*     
      logical ABORT
      character*(*) err
*     
      INCLUDE 'c_ntuple.cmn'
      INCLUDE 'gen_data_structures.cmn'
      INCLUDE 'gen_run_info.cmn'
      INCLUDE 'coin_data_structures.cmn'
      INCLUDE 'hes_data_structures.cmn'
      INCLUDE 'hks_data_structures.cmn'
      Include 'hks_physics_sing.cmn'
      INCLUDE 'hks_scin_parms.cmn'
      INCLUDE 'hks_track_histid.cmn'
      INCLUDE 'hks_aero_parms.cmn'
      INCLUDE 'hks_water_parms.cmn'
      INCLUDE 'hks_lucite_parms.cmn'
      INCLUDE 'h_ntuple.cmn'
      INCLUDE 'hks_tracking.cmn'
      INCLUDE 'gen_event_info.cmn'
      INCLUDE 'gen_scalers.cmn'
      INCLUDE 'hks_scin_tof.cmn'
      Include 'gen_epics.cmn'
*     
      logical HEXIST            !CERNLIB function
*     
      integer*4 m,i,j,k,ih,ie,cn
      Real*4 avedepo
      Integer*4 avendepo,hitn
      real*4 ts(5),hmsq
      integer*4 layer
*     
*--------------------------------------------------------
      err= ' '
      ABORT = .FALSE.
*     
      IF(.NOT.c_Ntuple_exists) RETURN !nothing to do
      
      IF(
     &     cnphysics.LE.0
     &     ) RETURN             ! No coincidence
      
**********begin insert description of contents of COIN tuple ******
      
cc      Write(*,*) '(cntkeep) cn=',cnphysics

      Do cn=1,CNPHYSICS
         ih=cnhks(cn) 
         ie=cnhes(cn)
         
*     --- put cut condition here

c         if(
c     &        esp(ie) .gt. 0 .and.
c     &        hsp(ih) .gt. 0
c     &        hsbeta(ih) .gt. 0 .and.
c     &        hsbeta(ih) .lt. 2.0
c     &        ) then
            
c     --- start ntuple contents
            m= 0
            m= m+1
            c_Ntuple_contents(m)= gepics_pbeam ! 0
            m= m+1
            c_Ntuple_contents(m)= hstime_at_fp(ih) ! 1 
            m= m+1
            c_Ntuple_contents(m)= hstime_at_tar(ih) ! 2
            m= m+1
            c_Ntuple_contents(m)= HSX_FP(ih) ! 3
            m= m+1
            c_Ntuple_contents(m)= HSY_FP(ih) ! 4
            m= m+1
            c_Ntuple_contents(m)= HSXP_FP(ih) ! 5
            m= m+1
            c_Ntuple_contents(m)= HSYP_FP(ih) ! 6
            m= m+1
            c_Ntuple_contents(m)= HSX_TAR(ih) ! 7
            m= m+1
            c_Ntuple_contents(m)= HSY_TAR(ih) ! 8
            m= m+1
            c_Ntuple_contents(m)= HSXP_TAR(ih) ! 9
            m= m+1
            c_Ntuple_contents(m)= HSYP_TAR(ih) ! 10
            m= m+1
            c_Ntuple_contents(m)= HSX_SV(ih) ! 11
            m= m+1
            c_Ntuple_contents(m)= HSY_SV(ih) ! 12
            m= m+1
            c_Ntuple_contents(m)= HSXP_SV(ih) ! 13
            m= m+1
            c_Ntuple_contents(m)= HSYP_SV(ih) ! 14
            m= m+1
            c_Ntuple_contents(m)= HSP(ih) ! 15
            m= m+1
            c_Ntuple_contents(m)= HSdelta(ih) ! 16
            m= m+1
            c_Ntuple_contents(m)= hsbeta(ih) ! 17
            m= m+1
            c_Ntuple_contents(m)= hsbeta1y(ih) ! 17
            m= m+1
            c_Ntuple_contents(m)= hsbeta_k(ih) ! 18
c     --- calculate mass for HKS             
            hmsq= (hsp(ih)*hsp(ih)*(1/hsbeta(ih)/hsbeta(ih)-1))
            m= m+1
            c_Ntuple_contents(m)= hmsq ! 18
c     --- number of hit aerogel layer
            hitn=0
            Do j=1,3
               if(htrk_naer(ih,j) .gt.0) then
                  hitn=hitn+1
               EndIf
            EndDo
            m= m+1
            c_Ntuple_contents(m)= float(hitn) ! 19
            m= m+1
            c_Ntuple_contents(m)= float(htrk_naer(ih,1)) ! 19 
            m= m+1
            c_Ntuple_contents(m)= float(htrk_naer(ih,2)) ! 19 
            m= m+1
            c_Ntuple_contents(m)= float(htrk_naer(ih,3)) ! 19 
            m= m+1
            c_Ntuple_contents(m)= HSAER_NPE(ih,1) ! 20
            m= m+1
            c_Ntuple_contents(m)= HSAER_NPE(ih,2) ! 21
            m= m+1
            c_Ntuple_contents(m)= HSAER_NPE(ih,3) ! 22
            m= m+1
            c_Ntuple_contents(m)= HSAER_NPE2(ih,1) ! 23 
            m= m+1
            c_Ntuple_contents(m)= HSAER_NPE2(ih,2) ! 24
            m= m+1
            c_Ntuple_contents(m)= HSAER_NPE2(ih,3) ! 25
            m= m+1
            c_Ntuple_contents(m)= HSAER_NPE_POS(ih,1) ! 20
            m= m+1
            c_Ntuple_contents(m)= HSAER_NPE_POS(ih,2) ! 21
            m= m+1
            c_Ntuple_contents(m)= HSAER_NPE_POS(ih,3) ! 22
            m= m+1
            c_Ntuple_contents(m)= HSAER_NPE_POS2(ih,1) ! 23 
            m= m+1
            c_Ntuple_contents(m)= HSAER_NPE_POS2(ih,2) ! 24
            m= m+1
            c_Ntuple_contents(m)= HSAER_NPE_POS2(ih,3) ! 25
            m= m+1
            c_Ntuple_contents(m)= HSAER_NPE_NEG(ih,1) ! 20
            m= m+1
            c_Ntuple_contents(m)= HSAER_NPE_NEG(ih,2) ! 21
            m= m+1
            c_Ntuple_contents(m)= HSAER_NPE_NEG(ih,3) ! 22
            m= m+1
            c_Ntuple_contents(m)= HSAER_NPE_NEG2(ih,1) ! 23 
            m= m+1
            c_Ntuple_contents(m)= HSAER_NPE_NEG2(ih,2) ! 24
            m= m+1
            c_Ntuple_contents(m)= HSAER_NPE_NEG2(ih,3) ! 25
            m= m+1
            c_Ntuple_contents(m)= HSAER_TIME(ih,1) ! 26
            m= m+1
            c_Ntuple_contents(m)= HSAER_TIME(ih,2) ! 27
            m= m+1
            c_Ntuple_contents(m)= HSAER_TIME(ih,3) ! 28
            m= m+1
            c_Ntuple_contents(m)= HSAER_TIME2(ih,1) ! 29 
            m= m+1
            c_Ntuple_contents(m)= HSAER_TIME2(ih,2) ! 30
            m= m+1
            c_Ntuple_contents(m)= HSAER_TIME2(ih,3) ! 31
            m= m+1
            c_Ntuple_contents(m)= HSAER_TIME_POS(ih,1) ! 26
            m= m+1
            c_Ntuple_contents(m)= HSAER_TIME_POS(ih,2) ! 27
            m= m+1
            c_Ntuple_contents(m)= HSAER_TIME_POS(ih,3) ! 28
            m= m+1
            c_Ntuple_contents(m)= HSAER_TIME_POS2(ih,1) ! 29 
            m= m+1
            c_Ntuple_contents(m)= HSAER_TIME_POS2(ih,2) ! 30
            m= m+1
            c_Ntuple_contents(m)= HSAER_TIME_POS2(ih,3) ! 31
            m= m+1
            c_Ntuple_contents(m)= HSAER_TIME_NEG(ih,1) ! 26
            m= m+1
            c_Ntuple_contents(m)= HSAER_TIME_NEG(ih,2) ! 27
            m= m+1
            c_Ntuple_contents(m)= HSAER_TIME_NEG(ih,3) ! 28
            m= m+1
            c_Ntuple_contents(m)= HSAER_TIME_NEG2(ih,1) ! 29 
            m= m+1
            c_Ntuple_contents(m)= HSAER_TIME_NEG2(ih,2) ! 30
            m= m+1
            c_Ntuple_contents(m)= HSAER_TIME_NEG2(ih,3) ! 31
            m= m+1
            c_Ntuple_contents(m)= HSAER_NUM(ih,1) ! 32 
            m= m+1
            c_Ntuple_contents(m)= HSAER_NUM(ih,2) ! 33
            m= m+1
            c_Ntuple_contents(m)= HSAER_NUM(ih,3) ! 34
c     --- number of hit water layer
            hitn=0
            Do j=1,2
               if(htrk_nwat(ih,j) .gt.0) then
                  hitn=hitn+1
               EndIf
            EndDo
            m= m+1
            c_Ntuple_contents(m)= float(hitn) ! 35
            m= m+1
            c_Ntuple_contents(m)= float(htrk_nwat(ih,1)) ! 35
            m= m+1
            c_Ntuple_contents(m)= float(htrk_nwat(ih,2)) ! 35
            m= m+1
            c_Ntuple_contents(m)= HSWAT_NPE(ih,1) ! 36
            m= m+1
            c_Ntuple_contents(m)= HSWAT_NPE(ih,2) ! 37
            m= m+1
            c_Ntuple_contents(m)= HSWAT_NPE2(ih,1) ! 38
            m= m+1
            c_Ntuple_contents(m)= HSWAT_NPE2(ih,2) ! 39
*add normalized kaon NPE  
            m= m+1
            c_Ntuple_contents(m)= HSWAT_NPE_K_RATIO(ih,1) ! 36
            m= m+1
            c_Ntuple_contents(m)= HSWAT_NPE_K_RATIO(ih,2) ! 37
            m= m+1
            c_Ntuple_contents(m)= HSWAT_NPE_K_RATIO2(ih,1) ! 38
            m= m+1
            c_Ntuple_contents(m)= HSWAT_NPE_K_RATIO2(ih,2) ! 39
*end
            m= m+1
            c_Ntuple_contents(m)= HSWAT_NPE_POS(ih,1) ! 36
            m= m+1
            c_Ntuple_contents(m)= HSWAT_NPE_POS(ih,2) ! 37
            m= m+1
            c_Ntuple_contents(m)= HSWAT_NPE_POS2(ih,1) ! 38
            m= m+1
            c_Ntuple_contents(m)= HSWAT_NPE_POS2(ih,2) ! 39
            m= m+1
            c_Ntuple_contents(m)= HSWAT_NPE_NEG(ih,1) ! 36
            m= m+1
            c_Ntuple_contents(m)= HSWAT_NPE_NEG(ih,2) ! 37
            m= m+1
            c_Ntuple_contents(m)= HSWAT_NPE_NEG2(ih,1) ! 38
            m= m+1
            c_Ntuple_contents(m)= HSWAT_NPE_NEG2(ih,2) ! 39
            m= m+1
            c_Ntuple_contents(m)= HSWAT_TIME(ih,1) ! 40
            m= m+1
            c_Ntuple_contents(m)= HSWAT_TIME(ih,2) ! 41
            m= m+1
            c_Ntuple_contents(m)= HSWAT_TIME2(ih,1) ! 42
            m= m+1
            c_Ntuple_contents(m)= HSWAT_TIME2(ih,2) ! 43
            m= m+1
            c_Ntuple_contents(m)= HSWAT_NUM(ih,1) ! 44
            m= m+1
            c_Ntuple_contents(m)= HSWAT_NUM(ih,2) ! 45
            m= m+1
            c_Ntuple_contents(m)= hschi2perdeg(ih) ! 46
            m= m+1
            c_Ntuple_contents(m)= hsnfree_fp(ih) ! 47
            do j = 1, hdc_num_layers
               m=m+1
               c_Ntuple_contents(m)=hsdc_sing_res(ih,j)    
            enddo
            do j = 1, hdc_num_layers
               m=m+1
               c_Ntuple_contents(m)=hsdc_track_coord(ih,j) 
            enddo
c     --- number of scin hit
            m= m+1
            c_Ntuple_contents(m)= hphys_scin_hit(ih,1) ! 48
            m= m+1
            c_Ntuple_contents(m)= hsnco1(ih) ! 49
            m= m+1
            c_Ntuple_contents(m)= hsnco2(ih) ! 50
            m= m+1
            c_Ntuple_contents(m)= hsnco3(ih) ! 51
            m= m+1
            c_Ntuple_contents(m)= hsnt1(ih) ! 52
            m= m+1
            c_Ntuple_contents(m)= hsnt2(ih) ! 53
            m= m+1
            c_Ntuple_contents(m)= hsnt3(ih) ! 54
            m= m+1
            c_Ntuple_contents(m)= hsnt1m(ih) ! 55
            m= m+1
            c_Ntuple_contents(m)= hsnt2m(ih) ! 56
            m= m+1
            c_Ntuple_contents(m)= hsnt3m(ih) ! 57
            m= m+1
            c_Ntuple_contents(m)= hsna1(ih) ! 58
            m= m+1
            c_Ntuple_contents(m)= hsna2(ih) ! 59
            m= m+1
            c_Ntuple_contents(m)= hsna3(ih) ! 60
            m= m+1
            c_Ntuple_contents(m)= hsna1m(ih) ! 61
            m= m+1
            c_Ntuple_contents(m)= hsna2m(ih) ! 62
            m= m+1
            c_Ntuple_contents(m)= hsna3m(ih) ! 63
c     --- average scintillator deposit per good scintillator hits
            avedepo = 0
            avendepo = 0
            Do j=1,3
               if(hsdedx(ih,j) .gt. 1) then
                  avendepo = avendepo + 1
                  avedepo = avedepo + hsdedx(ih,j)
               EndIf
            EndDo 
            avedepo = avedepo/Real(avendepo)
            m= m+1
            c_Ntuple_contents(m)= avedepo ! 64
            m= m+1
            c_Ntuple_contents(m)= hsrftime ! 65
            m= m+1
            c_Ntuple_contents(m)= hsrfdiff ! 66
*     ---hes 
            m= m+1
            c_Ntuple_contents(m)= estime_at_fp(ie) ! 67
            m= m+1
            c_Ntuple_contents(m)= estime_at_tar(ie) ! 68
            m= m+1
            c_Ntuple_contents(m)= esx_fp(ie) ! 69
            m= m+1
            c_Ntuple_contents(m)= esy_fp(ie) ! 70
            m= m+1
            c_Ntuple_contents(m)= esxp_fp(ie) ! 71
            m= m+1
            c_Ntuple_contents(m)= esyp_fp(ie) ! 72
            m= m+1
            c_Ntuple_contents(m)= esx_tar(ie) ! 73
            m= m+1
            c_Ntuple_contents(m)= esy_tar(ie) ! 74
            m= m+1
            c_Ntuple_contents(m)= esxp_tar(ie) ! 75
            m= m+1
            c_Ntuple_contents(m)= esyp_tar(ie) ! 76
            m= m+1
            c_Ntuple_contents(m)= esx_sv(ie) ! 77
            m= m+1
            c_Ntuple_contents(m)= esy_sv(ie) ! 78
            m= m+1
            c_Ntuple_contents(m)= esxp_sv(ie) ! 79
            m= m+1
            c_Ntuple_contents(m)= esyp_sv(ie) ! 80
            m= m+1
            c_Ntuple_contents(m)= esp(ie) ! 81
            m= m+1
            c_Ntuple_contents(m)= esdelta(ie) ! 82
c     ==========EDC =======================
            m= m+1
            c_Ntuple_contents(m)= eschi2perdeg(ie) ! 83 (chi square)
            m= m+1 
            c_Ntuple_contents(m)= esnfree_fp(ie) ! 84
            do layer=1 , emax_num_dc1_layers
               m= m+1
               c_Ntuple_contents(m) = edc1_resi(ie,layer) !(residual)
            enddo
            do layer=1 , emax_num_dc2_layers
               m= m+1
               c_Ntuple_contents(m) = edc2_resi(ie,layer) !(residual)
            enddo
c     =========HES HODOSCOPE (EHODO) =======
            m= m+1
            c_Ntuple_contents(m)= ephys_scin_hits(ie,1) ! 85 tot hits
            m= m+1
            c_Ntuple_contents(m)= esnco1(ie) ! 86
            m= m+1
            c_Ntuple_contents(m)= esnco2(ie) ! 87
            m= m+1
            c_Ntuple_contents(m)= esnt1(ie) ! 88
            m= m+1
            c_Ntuple_contents(m)= esnt2(ie) ! 89
            m= m+1
            c_Ntuple_contents(m)= esnt1m(ie) ! 90
            m= m+1
            c_Ntuple_contents(m)= esnt2m(ie) ! 91
            m= m+1
            c_Ntuple_contents(m)= esna1(ie) ! 92
            m= m+1
            c_Ntuple_contents(m)= esna2(ie) ! 93
            m= m+1
            c_Ntuple_contents(m)= esna1m(ie) ! 94
            m= m+1
            c_Ntuple_contents(m)= esna2m(ie) ! 95
c     --- hes avarage scintillator deposit
            m= m+1
            c_Ntuple_contents(m)= esscin_depo(ie) ! 96
            m= m+1
            c_Ntuple_contents(m)= esrftime ! 97
            m= m+1
            c_Ntuple_contents(m)= esrfdiff ! 98
c     --- beam position
c     --- extracted from g_analyze_misc
            m= m+1
            c_Ntuple_contents(m)= gfrx !GBEAM_X ! 99
            m= m+1
            c_Ntuple_contents(m)= gfry !GBEAM_Y ! 100
c     --- SLI
            m= m+1
            c_Ntuple_contents(m)= gepics_sli_espreadm ! 101
c     --- FFB
c     --- fast feedback on flag (1:off,0:on)
            m= m+1
            c_Ntuple_contents(m)= gepics_ffb_c_stat ! 102
c     --- fast energy rock on flag(1:on,0:off) 
            m= m+1
            c_Ntuple_contents(m)= gepics_ffb_c_use ! 103
c     --- IPM3C*** read out in cm (used be Energy drift)30Mar07 Y.O.
            m= m+1
            c_Ntuple_contents(m)= gbpm_meanx(1) ! 104
            m= m+1
            c_Ntuple_contents(m)= gbpm_meany(1) ! 104
            m= m+1
            c_Ntuple_contents(m)= gbpm_meanx(2) ! 104
            m= m+1
            c_Ntuple_contents(m)= gbpm_meany(2) ! 104
            m= m+1
            c_Ntuple_contents(m)= gbpm_meanx(3) ! 104
            m= m+1
            c_Ntuple_contents(m)= gbpm_meany(3) ! 104
c     --- coin
            m= m+1
            c_Ntuple_contents(m)= FLOAT(ih) ! 120
            m= m+1
            c_Ntuple_contents(m)= FLOAT(ie) ! 121
            m= m+1
            c_Ntuple_contents(m)= cnphysics ! 122
            m= m+1
            c_Ntuple_contents(m)= FLOAT(gen_event_ID_number) ! 123
            m= m+1
            c_Ntuple_contents(m)= FLOAT(gen_run_number) ! 124
            m= m+1
            c_Ntuple_contents(m)= coinrf ! 125
            m= m+1
            c_Ntuple_contents(m)= ctime_coin_cor(cn) ! 126
            m= m+1
            c_Ntuple_contents(m)= gtrig_flag_hes ! 127
            m= m+1
            c_Ntuple_contents(m)= gtrig_flag_kaonsum ! 128
            m= m+1
            c_Ntuple_contents(m)= gtrig_flag_kaonseg1 ! 129
            m= m+1
            c_Ntuple_contents(m)= gtrig_flag_kaonseg2 ! 130
            m= m+1
            c_Ntuple_contents(m)= gtrig_flag_kaonseg3 ! 131
            m= m+1
            c_Ntuple_contents(m)= gtrig_flag_kaonseg4 ! 132
            m= m+1
            c_Ntuple_contents(m)= gtrig_flag_kaonseg5 ! 133
            m= m+1
            c_Ntuple_contents(m)= gtrig_flag_kaonseg6 ! 134
            do j=1,5
               ts(j)=0.
               if(gen_event_ts_flag(j)) ts(j)=1
            enddo
            m= m+1
            c_Ntuple_contents(m)= ts(1) ! 135    
            m= m+1
            c_Ntuple_contents(m)= ts(2) ! 135    
            m= m+1
            c_Ntuple_contents(m)= ts(3) ! 135    
            m= m+1
            c_Ntuple_contents(m)= ts(5) ! 135    
            m= m+1
            c_Ntuple_contents(m)= happex ! 136

c     --- number of hit lucite layer
            hitn=0
            Do j=1,2
               if(htrk_nluc(ih,j) .gt.0) then
                  hitn=hitn+1
               EndIf
            EndDo
            m= m+1
            c_Ntuple_contents(m)= float(hitn) ! 139
            m= m+1
            c_Ntuple_contents(m)= HSLUC_NPE(ih,1) ! 140
            m= m+1
            c_Ntuple_contents(m)= HSLUC_NPE2(ih,1) ! 141
            m= m+1
            c_Ntuple_contents(m)= HSLUC_TIME(ih,1) ! 142
            m= m+1
            c_Ntuple_contents(m)= HSLUC_TIME2(ih,1) ! 143
            m= m+1
            c_Ntuple_contents(m)= HSLUC_NUM(ih,1) ! 144
            

***********end insert description of contents of COIN tuple********
            ABORT= .NOT.HEXIST(c_Ntuple_ID)
            IF(ABORT) THEN
               call G_build_note(':Ntuple ID#$ does not exist',
     &              '$',c_Ntuple_ID,' ',0.,' ',err)
               call G_add_path(here,err)
            ELSE
               call HFN(c_Ntuple_ID,c_Ntuple_contents)
            ENDIF
      EndDo                     ! cnphysics loop
      RETURN
      END      
      

OFFLINE=/work/hallc/hes-hks/gogami/tags/Oct14-2009/e05115src
##
INC=$(OFFLINE)/INCLUDE
LIBROOT= $(OFFLINE)/LIB
MAKEREG= $(OFFLINE)/makereg
CERNINC= -I/site/cernlib/i386_rhel3/2004/include/cfortran
CERNLIB= /site/cernlib/i386_rhel3/2004/lib
##
r_%.f : $(INC)/%.cmn
	(cp $< . ; $(MAKEREG) $(<F) -o $@ -e /dev/null; rm -f $(<F))
.PRECIOUS: r_%.f

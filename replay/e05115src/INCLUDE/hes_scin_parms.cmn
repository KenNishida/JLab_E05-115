*%%   include 'hes_data_structures.cmn'
*
*     CTPTYPE=parm             
* Probably don't really want the following registered
*
* hes hodoscope geometry
   
      real*4 escin_width
      real*4 escin_height
      real*4 escin_thickness
      real*4 escin_zpos(ENUM_SCIN_LAYERS)
      real*4 escin_xcenter(ENUM_SCIN_LAYERS,ENUM_SCIN_COUNTERS)
      real*4 escin_ycenter(ENUM_SCIN_LAYERS,ENUM_SCIN_COUNTERS)
      real*4 escin_all_ped_pos(enum_scin_layers,enum_scin_counters)
      real*4 escin_all_ped_neg(enum_scin_layers,enum_scin_counters)
      real*4 escin_f1tdc_gate_width
      real*4 escin_xslop
      real*4 escin_yslop
      real*4 escin_2la_offset
      real*4 escin_2la_time_gate
      real*4 escin_2co_time_gate
      real*4 estart_time_center
      real*4 estart_time_slop

      common/hes_scin_init/    
     &     escin_width, 
     &     escin_height, 
     &     escin_thickness,
     &     escin_zpos,
     &     escin_xcenter,
     &     escin_ycenter,
     &     escin_all_ped_pos,
     &     escin_all_ped_neg,
     &     escin_f1tdc_gate_width,
     &     escin_xslop,
     &     escin_yslop,
     &     escin_2la_offset,
     &     escin_2la_time_gate,
     &     escin_2co_time_gate,
     &     estart_time_center,
     &     estart_time_slop


* Physical paramteres of counters.  Use shodo_* for arrays that include
*   the entire hodoscope,  hscin_* for arrays that loop over hits.

      real*4 escin_pos_coord(enum_scin_layers,enum_scin_counters)
      real*4 escin_neg_coord(enum_scin_layers,enum_scin_counters)

* callibration type variables.
      real*4 escin_slop(enum_scin_layers)
      real*4 escin_vel_light(enum_scin_layers,enum_scin_counters)

* correction parameters and position information converted to arryas
* over layer and counter

      common/hes_tof_parms/
     &     escin_pos_coord,
     &     escin_neg_coord,
     &     escin_slop,
     &     escin_vel_light

* called in e_trans_scin

      Integer*4 escin_adcpos_min
      Integer*4 escin_adcpos_max
      Integer*4 escin_tdcpos_min
      Integer*4 escin_tdcpos_max
      Integer*4 escin_adcneg_min
      Integer*4 escin_adcneg_max
      Integer*4 escin_tdcneg_min
      Integer*4 escin_tdcneg_max
      Integer*4 edebugprintscinraw
      Integer*4 edumpdecodedscin
      Integer*4 escin_miss_channel(ENUM_SCIN_LAYERS,ENUM_SCIN_COUNTERS) !DK add
      Real*4 escin_pos_ped_mean(ENUM_SCIN_LAYERS,ENUM_SCIN_COUNTERS)
      Real*4 escin_neg_ped_mean(ENUM_SCIN_LAYERS,ENUM_SCIN_COUNTERS)
      Real*4 escin_tdc_to_time
      real*4 escin_pos_minph(enum_scin_layers,enum_scin_counters)
      real*4 escin_neg_minph(enum_scin_layers,enum_scin_counters)
      Real*4 escin_pos_phc_coeff(ENUM_SCIN_LAYERS,ENUM_SCIN_COUNTERS)
      Real*4 escin_pos_time_offset(ENUM_SCIN_LAYERS,ENUM_SCIN_COUNTERS)
      Real*4 escin_neg_phc_coeff(ENUM_SCIN_LAYERS,ENUM_SCIN_COUNTERS)
      Real*4 escin_neg_time_offset(ENUM_SCIN_LAYERS,ENUM_SCIN_COUNTERS)
      Real*4 escin_dt_gate
*     --- used in e_link_tracks.f
      Real*4 etrk_time_gate

        common/hes_scin_parms/
     &        edebugprintscinraw,
     &        edumpdecodedscin,
     & 		  escin_miss_channel,
     &        escin_pos_ped_mean,
     &        escin_neg_ped_mean,
     &        escin_adcpos_min,
     &        escin_adcpos_max,
     &        escin_tdcpos_min,
     &        escin_tdcpos_max,
     &        escin_adcneg_min,
     &        escin_adcneg_max,
     &        escin_tdcneg_min,
     &        escin_tdcneg_max,
     &        escin_pos_minph,
     &        escin_neg_minph,
     &        escin_tdc_to_time,
     &        escin_pos_phc_coeff,
     &        escin_neg_phc_coeff,
     &        escin_pos_time_offset,
     &        escin_neg_time_offset,
     &        escin_dt_gate,
     &        etrk_time_gate

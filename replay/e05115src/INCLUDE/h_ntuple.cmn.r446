      integer HMAX_Ntuple_size
      parameter (HMAX_Ntuple_size= 100)
      integer default_h_Ntuple_ID
      parameter (default_h_Ntuple_ID= 9020)
      integer default_h_dc_Ntuple_ID
      parameter (default_h_dc_Ntuple_ID= 9023)
      integer default_h_track_Ntuple_ID
      parameter (default_h_track_Ntuple_ID= 9021)
      integer default_h_scin_Ntuple_ID
      parameter (default_h_scin_Ntuple_ID= 9022)

*     
*     Common block that contains the mapping of physical fastbus locations
*     to logical detector identification.
*     
*     $Log: gen_decode_common.cmn,v $
*     Revision 1.1.1.1  2009/06/23 13:55:43  kawama
*
*     e05115 src repository for software development
*
*     Revision 1.4  2005/06/17 19:51:24  cdaq
*     add decode filter flag
*
*     Revision 1.3  2005/06/15 00:28:53  cdaq
*     increase max decode vector size
*
*     Revision 1.2  2005/05/28 00:41:49  cdaq
*     change maxroc
*
*     Revision 1.1.1.1  2005/05/14 21:44:37  miyoshi
*
*
*     Revision 1.5  2005/02/22 22:02:54  miyoshi
*     when exceeding decode max words, skip decording
*
*     Revision 1.4  2005/02/07 22:49:39  miyoshi
*     increase max slot number
*
*     Revision 1.3  2004/12/24 19:41:46  miyoshi
*     add some variables and parameters
*
*     Revision 1.2  2004/12/23 22:05:53  miyoshi
*     move f1 variables to gen_f1tdc.cmn
*
*     Revision 1.1.1.1  2004/08/30 21:21:37  miyoshi
*     new dir
*
*     
*     Revision 2.0 2000/02/17 16:37:56 jinghua for HNSS
*     (JLiu) increase array g_threshold_readback's size
*     max_roc from 3 to 8, max_slot from 15 to 25
*     
*     Revision 1.4  1996/01/17 15:40:59  cdaq
*     (SAW) Change roc index in arrays to start at zero.
*     (JRA) Add structures needed to produce adc threshold setting files.
*     
*     Revision 1.3  1994/10/20 12:26:44  cdaq
*     (JRA) Increate G_DECODE_MAXROCS from 8 to 9
*     
*     Revision 1.2  1994/04/05  14:31:10  cdaq
*     Add g_decode_subaddbit for location in FB word of sub address
*     
*     Revision 1.1  1994/02/07  19:36:23  cdaq
*     Initial revision
*
*
      integer G_DECODE_MAXWORDS                 ! Must exceed number of
      parameter (G_DECODE_MAXWORDS=8000)        ! installed FB channels
      integer G_DECODE_MAXROCS
      parameter (G_DECODE_MAXROCS=15) ! Largest ROC # + 1
      integer G_DECODE_MAXSLOTS
      parameter (G_DECODE_MAXSLOTS=29)          ! # slots in a FB crate
*     ---  Pointer into map arrays
      integer*4 g_decode_slotpointer(0:G_DECODE_MAXROCS, G_DECODE_MAXSLOTS)
*     --- Number of subadds per slot
      integer*4 g_decode_subaddcnt(0:G_DECODE_MAXROCS,G_DECODE_MAXSLOTS)
*     --- bit shift to get subadd
      integer*4 g_decode_subaddbit(0:G_DECODE_MAXROCS,G_DECODE_MAXSLOTS)
      integer*4 g_decode_slotmask(0:G_DECODE_MAXROCS,G_DECODE_MAXSLOTS)

      integer*4 g_decode_didmap(G_DECODE_MAXWORDS)
      integer*4 g_decode_planemap(G_DECODE_MAXWORDS)
      integer*4 g_decode_countermap(G_DECODE_MAXWORDS)
      integer*4 g_decode_sigtypmap(G_DECODE_MAXWORDS)
*     --- Next free in map arrays
      integer*4 g_decode_nextpointer
            
      common /UPCOMMON/
     $     g_decode_slotpointer,
     $     g_decode_subaddcnt,
     $     g_decode_subaddbit,
     $     g_decode_slotmask,
     $     g_decode_didmap,
     $     g_decode_planemap,
     $     g_decode_countermap,
     $     g_decode_sigtypmap,
     $     g_decode_nextpointer

      integer*4 gmax_roc_with_adc
      integer*4 gmax_slot_with_adc
      integer*4 gnum_adc_channels
      parameter (gmax_roc_with_adc=8)
      parameter (gmax_slot_with_adc=G_DECODE_MAXSLOTS)
      parameter (gnum_adc_channels=64)

* use slot,roc so that g_threshold_readback(1,3,7) >>> thresholds(*) gives
* the thresholds(1-64) = the 64 thresholds in roc3,slot7.

      integer*4 g_threshold_readback(gnum_adc_channels,
     &             gmax_roc_with_adc,gmax_slot_with_adc)

      common/gen_threshold_check/
     &     g_threshold_readback

*
*     CTPTYPE=parm
*
      Integer*4 g_decode_debug
      Integer*4 g_decode_filter_on
      Integer*4 g_decode_pedana

      Common/gen_decode_debug/
     &     g_decode_debug,
     &     g_decode_filter_on,
     &     g_decode_pedana

*     Local Variables:
*     mode: fortran
*     End:

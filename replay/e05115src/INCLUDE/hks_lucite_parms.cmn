      INTEGER*4 hluc_tdc_pos_min
      INTEGER*4 hluc_tdc_pos_max
      INTEGER*4 hluc_tdc_neg_min
      INTEGER*4 hluc_tdc_neg_max
      INTEGER*4 hluc_tdc_tot_min
      INTEGER*4 hluc_tdc_tot_max


      REAL*4 hluc_pos_gain(HNUM_LUC_LAYERS,HNUM_LUC_COUNTERS)
      REAL*4 hluc_neg_gain(HNUM_LUC_LAYERS,HNUM_LUC_COUNTERS)
      REAL*4 hluc_tot_gain(HNUM_LUC_LAYERS,HNUM_LUC_COUNTERS)
      REAL*4 hluc_pos_offset(HNUM_LUC_LAYERS,HNUM_LUC_COUNTERS)
      REAL*4 hluc_neg_offset(HNUM_LUC_LAYERS,HNUM_LUC_COUNTERS)
      REAL*4 hluc_tot_offset(HNUM_LUC_LAYERS,HNUM_LUC_COUNTERS)
	
      REAL*4 hluc_pos_time_offset(HNUM_LUC_LAYERS,HNUM_LUC_COUNTERS)
      REAL*4 hluc_neg_time_offset(HNUM_LUC_LAYERS,HNUM_LUC_COUNTERS)
      REAL*4 hluc_tot_time_offset(HNUM_LUC_LAYERS,HNUM_LUC_COUNTERS)

      REAL*4 hluc_box_zpos(HNUM_LUC_LAYERS)
      REAL*4 hluc_box_xcenter(HNUM_LUC_LAYERS,HNUM_LUC_COUNTERS)
      REAL*4 hluc_box_ycenter(HNUM_LUC_LAYERS,HNUM_LUC_COUNTERS)
      REAL*4 hluc_width
      REAL*4 hluc_height
      REAL*4 hluc_thickness
      REAL*4 hluc_slope
      REAL*4 hluc_tdc_to_time
      Real*4 hluc_npe_min
      Real*4 hluc_f1tdc_gate_width

      common/hks_lucite_parms/
     &  hluc_tdc_pos_min,

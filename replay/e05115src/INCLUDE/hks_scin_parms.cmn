*     hks_scin_parms.cmn -  two common blocks:
*     
*     hks_scin_parms - variables from the hks_positions.parm file
*     hks_tof_parms  - tof correction parameters and position parameters
*     converted to arrays over layer,counter by s_init_scin.
*     
*     NOTE:  Variables whose names start with sHODO are arrays over
*     layer and counter.  sSCIN is used for parameters from the
*     .parm files and for arrays over hits.
*     
*     Modified 23 March 1994   DFG
*     Add definition of snum_scin_elements and set parameter value
*     
*     $Log: hks_scin_parms.cmn,v $
*     Revision 1.1.1.1  2009/06/23 13:55:43  kawama
*
*     e05115 src repository for software development
*
*     Revision 1.2  2005/07/06 19:22:38  sumihama
*     Mod.hrf/erf
*
*     Revision 1.1.1.1  2005/05/14 21:44:37  miyoshi
*
*
*     Revision 1.4  2005/04/08 18:28:12  miyoshi
*     change names
*
*     Revision 1.3  2005/03/14 19:47:51  miyoshi
*     change hscin names
*
*     Revision 1.2  2004/12/24 21:18:50  miyoshi
*     change name plane to layer
*
*     Revision 1.1.1.1  2004/08/30 21:21:38  miyoshi
*     new dir
*
*     Revision 1.8  1996/09/04 16:31:26  saw
*     (JRA) Add misc scaler
*     
*     Revision 1.7  1996/01/24 16:20:17  saw
*     (JRA) Make smisc_dec_data two dimensional
*     
*     Revision 1.6  1995/08/11 16:35:55  cdaq
*     (JRA) Remove old dpos stuff
*     Add sscin_zero accumulators
*     
*     Revision 1.5  1995/05/22  19:11:54  cdaq
*     (SAW) Split gen_data_data_structures into gen, hms, hks, and coin parts.
*     Make pedestal arrays real.  Add hks_scin_positions and hks_misc_parms commons
*     
*     Revision 1.4  1995/03/13  19:09:11  cdaq
*     (JRA) Move snum_scin_elements to gen_data_structures, remove
*     sscin_num_counters.  Change sscin_??_top and _left to center and offset.
*     Add sscin_??_spacing parms.  Change shodo_center_coord to shodo_center.
*     Add shodo_???_minph tables.
*     
*     Revision 1.3  1994/11/21  18:01:35  cdaq
*     * (SPB) Recopied from hms file and modified names for HKS
*     
*     Revision 1.2  1994/08/05  21:00:21  cdaq
*     (SAW) Add makereg directive with required include files
*     Add "CTPTYPE=parm" directive for auto generation of CTP reg calls
*     
*     Revision 1.1  1994/04/12  21:15:29  cdaq
*     Initial revision
*     
*     The following include statments must precede the inclusion of this
*     file in each routine that uses it.  The *%% syntax is also a
*     directive to makereg to tell it to include the code in the program
*     that it generates.
*     
*%%   include 'hks_data_structures.cmn'
*     
*     CTPTYPE=parm
*     
*     from parameter file
      integer*4 hscin_1x_nr
      integer*4 hscin_1y_nr
      integer*4 hscin_2x_nr
      integer*4 hdebugprinttoftracks
      integer*4 hdebugprinttracktests

      real*4 hscin_zpos(hnum_scin_layers)
      real*4 hscin_1x_dzpos
      real*4 hscin_1y_dzpos
      real*4 hscin_2x_dzpos

      real*4 hscin_1x_top
      real*4 hscin_1x_bot
      real*4 hscin_1y_left
      real*4 hscin_1y_right
      real*4 hscin_2x_top
      real*4 hscin_2x_bot

      real*4 hscin_width(hnum_scin_layers)
      real*4 hscin_slope(hnum_scin_layers)
      real*4 hscin_1x_center(hnum_scin_elements)
      real*4 hscin_1y_center(hnum_scin_elements)
      real*4 hscin_2x_center(hnum_scin_elements)
      real*4 hscin_1x_offset
      real*4 hscin_1y_offset
      real*4 hscin_2x_offset
      real*4 hscin_1x_size
      real*4 hscin_1y_size
      real*4 hscin_2x_size
      real*4 hscin_1x_spacing
      real*4 hscin_1y_spacing
      real*4 hscin_2x_spacing
      real*4 hscin_raw_ped_pos(hnum_scin_layers,hnum_scin_elements)
      real*4 hscin_raw_ped_neg(hnum_scin_layers,hnum_scin_elements)
      real*4 hscin_f1tdc_gate_width
      
*
*     filled at hhodo.pos
*

      common/hks_scin_parms/   
     &     hscin_zpos,
     &     hscin_1x_nr, hscin_1y_nr,
     &     hscin_2x_nr,
     &     hscin_1x_dzpos, hscin_1y_dzpos,
     &     hscin_2x_dzpos,
     &     hscin_1x_top, hscin_1y_left,
     &     hscin_2x_top,
     &     hscin_1x_bot, hscin_1y_right,
     &     hscin_2x_bot,
     &     hscin_width,
     &     hscin_slope,
     &     hscin_1x_center, hscin_1y_center, 
     &     hscin_2x_center,
     &     hscin_1x_size, hscin_1y_size, 
     &     hscin_2x_size,
     &     hscin_1x_spacing, hscin_1y_spacing,
     &     hscin_2x_spacing,
     &     hdebugprinttoftracks,
     &     hdebugprinttracktests,
     &     hscin_raw_ped_pos,
     &     hscin_raw_ped_neg,
     &     hscin_f1tdc_gate_width,
     &     hscin_1x_offset, hscin_1y_offset,
     &     hscin_2x_offset
      
*     Physical paramteres of counters.  Use shodo_* for arrays that include
*     the entire hodoscope,  hscin_* for arrays that loop over hits.

      real*4 hnum_scin_counters(hnum_scin_layers)
      real*4 hscin_center(hnum_scin_layers,hnum_scin_elements)
      
*     callibration type variables.
      real*4 hscin_vel_light(hnum_scin_layers,hnum_scin_elements)
      real*4 hscin_pos_sigma(hnum_scin_layers,hnum_scin_elements)
      real*4 hscin_neg_sigma(hnum_scin_layers,hnum_scin_elements)
      real*4 hscin_pos_phc_coeff(hnum_scin_layers,hnum_scin_elements)
      real*4 hscin_neg_phc_coeff(hnum_scin_layers,hnum_scin_elements)
      real*4 hscin_pos_time_offset(hnum_scin_layers,hnum_scin_elements)
      real*4 hscin_neg_time_offset(hnum_scin_layers,hnum_scin_elements)
      real*4 hscin_pos_phc_coeff2(hnum_scin_layers,hnum_scin_elements)
      real*4 hscin_neg_phc_coeff2(hnum_scin_layers,hnum_scin_elements)
      real*4 hscin_pos_minph(hnum_scin_layers,hnum_scin_elements) 
      real*4 hscin_neg_minph(hnum_scin_layers,hnum_scin_elements) 
*     ! ADC offset for PH correction
      
*     correction parameters and position information converted to arryas
*     over layer and counter
      
      common/hks_tof_parms/
     &     hnum_scin_counters,
     &     hscin_center,
     &     hscin_vel_light,
     &     hscin_pos_sigma,
     &     hscin_neg_sigma,
     &     hscin_pos_phc_coeff,
     &     hscin_neg_phc_coeff,
     &     hscin_pos_time_offset,
     &     hscin_neg_time_offset,
     &     hscin_pos_phc_coeff2,
     &     hscin_neg_phc_coeff2,
     $     hscin_pos_minph,
     $     hscin_neg_minph
      
      integer*4 hscin_zero_pos(hnum_scin_layers,hnum_scin_elements)
      integer*4 hscin_zero_neg(hnum_scin_layers,hnum_scin_elements)
      integer*4 hscin_zero_num(hnum_scin_layers,hnum_scin_elements)
      real*4 hscin_zero_pave(hnum_scin_layers,hnum_scin_elements)
      real*4 hscin_zero_nave(hnum_scin_layers,hnum_scin_elements)
      
      common /hks_scin_zero/
     &     hscin_zero_pos,hscin_zero_neg,
     &     hscin_zero_num,
     &     hscin_zero_pave,hscin_zero_nave
      

      real*4 gepics_dpp,gepics_ebeam,gepics_pbeam
      real*4 gepics_dbdl,gepics_diset,gepics_diread
      real*4 gepics_xbeam(3),gepics_ybeam(3),gepics_zbeam(3)
      real*4 gepics_otr_x,gepics_otr_y
      real*4 gepics_otr_widx,gepics_otr_widy
      real*4 gepics_otr_maxpix,gepics_otr_sat
      real*4 gepics_nmr_field,gepics_nmr_lock
      real*4 gepics_mag_temp1,gepics_mag_temp2
      real*4 gepics_mag_temp3,gepics_mag_temp4,gepics_mag_temp5
      real*4 gepics_ffb_c_stat,gepics_ffb_c_use
      real*4 gepics_bcm1, gepics_bcm2, gepics_bcm3
c     --- sli info.
      REAL*4 gepics_sli_dywids
      REAL*4 gepics_sli_dywidm
      REAL*4 gepics_sli_dywidme
      REAL*4 gepics_sli_spreads
      REAL*4 gepics_sli_espreadm
      REAL*4 gepics_sli_espreadme


      COMMON/g_epics_events/
     &     gepics_delta_ebeam,

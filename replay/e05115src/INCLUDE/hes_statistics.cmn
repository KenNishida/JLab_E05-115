*%%   include 'hes_data_structures.cmn'
*     
*     
*     CTPTYPE=parm             ! Probably don't really want the following registered
*     
      Integer*4 estat_nevents
      
      Common/hes_statistics/
     &     estat_nevents
      
*     
*     CTPTYPE=event
*     
      Integer*4 escin_rough_tot_events(ENUM_SCIN_LAYERS) 
*     ! # of good track
      Integer*4 escin_rough_events(ENUM_SCIN_LAYERS)     
      
      Real*4 escin_layer_rough_eff(ENUM_SCIN_LAYERS)
     
	   Integer*4 escineff_good_trig(3,29)
	   Integer*4 escineff_did_trig(3,29)
	   Integer*4 escin_layer_eff(3,29)
	   Integer*4 escin_layer_eff_err(3,29)
		 
      common/escin_statistics/
     &     escin_rough_tot_events,
     &     escin_rough_events,
     &     escin_layer_rough_eff,
     &     escineff_good_trig,
     &     escineff_did_trig,
     &     escin_layer_eff,
     &     escin_layer_eff_err
      
*     efficiency stuff

      Integer*4 edc1eff_good_trig
      Integer*4 edc1eff_did_trig(emax_num_dc1_layers)
      Real*4 edc1_layer_eff(emax_num_dc1_layers)
      Real*4 edc1_layer_eff_err(emax_num_dc1_layers)
      
      common/edc1_statistics/
     &     edc1eff_good_trig,
     &     edc1eff_did_trig,
     &     edc1_layer_eff,
     &     edc1_layer_eff_err

	  	Integer*4 edc1eff_layer
	  	Integer*4 edc1eff_flag(5120)
	  	Real*4 edc1eff_residual(5120,emax_num_dc1_layers+1,4)
	  	Real*4 edc1effx_fp_pre(5120,emax_num_dc1_layers+1,4)
	  	Real*4 edc1effy_fp_pre(5120,emax_num_dc1_layers+1,4)
	  	Real*4 edc1effxp_fp_pre(5120,emax_num_dc1_layers+1,4)
	  	Real*4 edc1effyp_fp_pre(5120,emax_num_dc1_layers+1,4)

      common/edc1_efficiency/
     &		edc1eff_layer,
     &		edc1eff_flag,
     &		edc1eff_residual,
     &		edc1effx_fp_pre,
     &		edc1effy_fp_pre,
     &		edc1effxp_fp_pre,
     &		edc1effyp_fp_pre



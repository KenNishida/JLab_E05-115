*     CTPTYPE=event
*     
       integer*4 h_kept_track_ID_number
       integer*4 h_kept_ntrack
       integer*4 h_kept_track_index
       
       Common /hks_tracking_output_event/
     &      h_kept_track_ID_number,
     &      h_kept_ntrack,
     &      h_kept_track_index
       
*     
*     CTPTYPE=event
*     
       integer*4 h_kept_tar_ID_number
       integer*4 h_kept_ntar
       integer*4 h_kept_tar_index
       
       Common /hks_target_output_event/
     &      h_kept_tar_ID_number,
     &      h_kept_ntar,
     &      h_kept_tar_index

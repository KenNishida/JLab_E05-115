      common/hks_dead_wires/
     &   hdc_num_deadwires,  
     &   hdc_deadwire_layer, 
     &   hdc_deadwire_num    


*
*     CTPTYPE=parm
*
      logical h1hit1,h1hit2,h1hit3,h1hit4,h1hit5,h1hit6
      logical h1hit7,h1hit8,h1hit9,h1hit10,h1hit11,h1hit12
      logical h1hitslt,h2hitslt,h1layersgt,h2layersgt
      logical hhitslt,hlayersgt
      logical hstublt
      logical f1hspacepoints,f2hspacepoints,fhspacepoints
      logical hhitslayers,hhitslayerssps,hhitslayersspsstubs

*     CTPTYPE=parm
*     
*     output tracking results
*     
       integer*4 h_track_output_on
       integer*4 h_tar_output_on
       
       Common /hks_tracking_output_flag/
     &      h_track_output_on,
     &      h_tar_output_on
       

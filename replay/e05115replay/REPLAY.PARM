; PREPROCESSOR FLAGS. Uncomment and 
; change g_preproc_event.f to make reduced data files.
; should also disable unnecessary analysis 
; in gdebug.param file.

g_preproc_on=0
;g_preproc_filename='output/dummy_short_%d.log'

;INPUT FILES.
  g_ctp_database_filename =   'DBASE/e05115.database' 
; pointers to map/param files.
  g_ctp_test_filename =       'CTP/e05115.test'       
; ctp test definitions.
  g_ctp_hist_filename =       'CTP/e05115.hist'       
; ctp histogram definitions.

;RUN FLAGS.
; 1=on 0=disabled
; gen_run_enable(i) 
; i=1 HKS triggers
; i=2 HES triggers, 
; i=3 COIN triggers
; i=4 PED triggers (disable may not work)

 gen_run_enable(1) = 1
 gen_run_enable(2) = 0   
 gen_run_enable(3) = 0
 gen_run_enable(4) = 1  


; Filled in h_fill_dc_raw_hist

hdcrawtothit,130,-0.5,1299.5     $HDC raw tot hits
hdcrawtothitzoom,500,-0.5,499.5    $HDC raw tot hits (zoom)
hdcrawtdcall,50,-100.,6400.  $HDC raw tdc (all)


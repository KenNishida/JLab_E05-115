begin test hks_misc_vars group=hks group=both
#real hdelta_beta
hdelta_beta = hhbeta - hhbeta_p
hhmass2=hhp*hhp*(1/(hhbeta+.000001)/(hhbeta+.000001)-1)
#real hhx_aero
hhx_aero=hhx_fp+253.8*hhxp_fp
#real hhy_aero
hhy_aero=hhy_fp+253.8*hhyp_fp
end   test hks_misc_vars

begin test hks_collim_optics_check group=hks group=both
#real hks_x_collim,hks_y_collim
hks_x_collim=hhxp_tar*(126.3+hhy_tar/tan(htheta_lab))
hks_y_collim=hhyp_tar*(126.3+hhy_tar/tan(htheta_lab))+hhy_tar
end test hks_collim_optics_check

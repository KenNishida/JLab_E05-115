begin hist hes_physics group=hes
enphysics,20,0.,20.         $number of events in hes
ephysscinhits,20,0.,20.     $number of scin hits in hes
esxfp,100,-60.,60.          $es x fp
esyfp,100,-10.,10.          $es y fp
esxpfp,100,-0.5,0.5         $es xp fp
esypfp,100,-0.2,0.2         $es yp fp
esxtar,100,-20.,20.          $es x tar
esytar,100,-20.,20.         $es y tar
esxptar,100,-0.3,0.3        $es xp tar
esyptar,100,-0.3,0.3        $es yp tar
esdelta,100,-40.,40.        $es delta
estimeatfp,100,-10.,20.     $estime at fp
esp,100,0.65,1.15              $es momentum
esenergy,100,0.65,1.15         $es energy
esxdclayer1,60,-60.,60.     $es x at dc-layer1
esydclayer1,60,-30.,30.     $es y at dc-layer1
esxs1,60,-60.,60.           $es x at hodo-layer1
esys1,60,-30.,30.           $es y at hodo-layer1
esxs2,60,-60.,60.           $es x at hodo-layer2
esys2,60,-30.,30.           $es y at hodo-layer2
espathlength,500, 200.,700. $es path length
estimeattar,120,-30.,10.    $es time at tar
esrfdiff,50,-1000.,1000.    $es rf timediff
esrftime,500,0.,2000. $es rf time
eschi2perdeg,50,0.,50.      $es chi2 per dof at fp
eseloss, 20,0.,0.1          $es eloss
escorre, 60,0.,0.6          $es corre  
escorrp, 60,0.,0.6          $es corrp
estheta,80,0.,20.           $es theta(deg)
eskpvec1,200,0.,0.6         $es kpvec1
eskpvec2,200,-0.3,0.3       $es kpvec2
eskpvec3,200,-0.3,0.3       $es kpvec3
eskpvec4,200,0.,0.6         $es kpvec4
esphi,60,0.,8.              $es phi
eszbeam,120,-30.,30.0       $es zbeam
end hist hes_physics   

edc1fpyp,200,-0.05,0.05              $EDC1 yp fp
edc1fpxy,200,-60.,60.,60,-10.,10.   $EDC1 x vs y at fp
edc1fpxpyp,200,-0.2,  0.2, 200,  -0.05, 0.05  $EDC1 xp vs yp at fp
edc1fpxxp, 200, -40., 50., 200,   -.2,  .2    $EDC1 x vs xp at fp
edc1fpxyp, 200, -40., 50., 200,  -0.05, 0.05  $EDC1 x vs yp at fp
edc1fpyxp, 200, -10., 10., 200,   -.2,  .2    $EDC1 y vs xp at fp
edc1fpyyp, 200, -10., 10., 200,  -0.05, 0.05  $EDC1 y vs yp at fp

dtime_edc201,200,-100,300   $EDC2 u drift time  1
dtime_edc202,200,-100,300   $EDC2 u' drift time  2
dtime_edc203,200,-100,300   $EDC2 x drift time  3
dtime_edc204,200,-100,300   $EDC2 x' drift time  4
dtime_edc205,200,-100,300   $EDC2 v drift time  5
dtime_edc206,200,-100,300   $EDC2 v' drift time  6

edc2driftdis01,100,-1.,1.     $EDC2 drift dis 01
edc2driftdis02,100,-1.,1.     $EDC2 drift dis 02

edc1singres01,200,-0.2,0.2.     $EDC1 single residual 01
edc1singres02,200,-0.2,0.2.     $EDC1 single residual 02
edc1singres03,200,-0.2,0.2.     $EDC1 single residual 03
edc1singres04,200,-0.2,0.2.     $EDC1 single residual 04
edc1singres05,200,-0.2,0.2.     $EDC1 single residual 05
edc1singres06,200,-0.2,0.2.     $EDC1 single residual 06
edc1singres07,200,-0.2,0.2.     $EDC1 single residual 07
edc1singres08,200,-0.2,0.2.     $EDC1 single residual 08
edc1singres09,200,-0.2,0.2.     $EDC1 single residual 09
edc1singres10,200,-0.2,0.2.     $EDC1 single residual 10

edc1fpx,200,-60.,60.                $EDC1 x fp
edc1fpy,200,-10.,10.                $EDC1 y fp

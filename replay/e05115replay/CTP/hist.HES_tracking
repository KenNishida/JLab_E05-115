edc2singres05,200,-1.,1.     $EDC2 single residual 05
edc2singres06,200,-1.,1.     $EDC2 single residual 06
edc2fpx,500,-60.,60.                $EDC2 x fp
edc2fpy,120,-15.,15.                $EDC2 y fp
edc2fpxp,100,-1.5,1.5               $EDC2 xp fp
edc2fpyp,120,-0.25,0.25               $EDC2 yp fp
edc2fpxy,120,-60.,60.,60,-15.,15.   $EDC2 x vs y at fp
edc2fpxpyp,50,-1.5,1.5,60,-0.25,0.25  $EDC2 xp vs yp at fp
edc2fpxxp, 500, -40., 50., 50,   -.2, .6    $EDC2 x vs xp at fp
edc2fpxyp, 120, -40., 50., 60, -0.07, 0.03  $EDC2 x vs yp at fp
edc2fpyxp,  60,  -5.,  5., 50,   -.2, .6    $EDC2 y vs xp at fp
edc2fpyyp,  60,  -5.,  5., 60, -0.07, 0.03  $EDC2 y vs yp at fp

entracksfp,100,0.,1000.     $ntrack fp
entracksfpzoom,20,0.,20.    $ntrack fp (zoom)
echi2perdoffp,100,0.,500.           $chi2perdof fp
echi2perdoffpzoom,100,0.,20.        $chi2perdof fp (zoom)
efpx,200,-60.,60.                $x fp
efpy,200,-10.,10.                $y fp
efpxp,200,-0.2,0.2               $xp fp
efpyp,200,-0.10,0.00             $yp fp
efpxy,200,-60.,60.,60,-10.,10.   $x vs y at fp
efpxpyp,200,-0.2,  0.2, 200,  -0.10, 0.00  $xp vs yp at fp
efpxxp, 200, -40., 50., 200,   -.2,  .2    $x vs xp at fp
efpxyp, 200, -40., 50., 200,  -0.10, 0.00  $x vs yp at fp
efpyxp, 200, -10., 10., 200,   -.2,  .2    $y vs xp at fp
efpyyp, 200, -10., 10., 200,  -0.10, 0.00  $y vs yp at fp

end hist hes_tracking

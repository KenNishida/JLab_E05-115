begin hist hks_tar group=hks group=both
hxtar,20,-2.,2.        $hx-tar
hytar,20,-2.,2.        $hy-tar
hxptar,100,-0.4,0.4    $hxp-tar
hyptar,100,-0.3,0.3    $hyp-tar
htarxpyp,100,-0.4,0.4,100,-0.3,0.3 $hks target yp vs xp

hdeltatar,120,-15.,15. $hdelta-tar
hptar,120,0.9,1.5      $hp-tar
;hpwide,100,-2.,3.       $hp-tar (wide)

hxsv,100,-15.,15.       $hx-sv
hysv,100,-15.,15.       $hy-sv
hsvxy,100,-15., 15., 100, -15., 15.   $hks sv y vs x
end   hist hks_tar

; Aerogel SP-50 position is -12.5 from center of the detector box.

; Geometrical parameters input by V.M. Rodriguez 05/27/05

     haer_box_zpos = 124.6-12.5, 156.8-12.5, 188.9-12.5


; Regarding Joerg Reinhold, the aerogel SP-50 is tiled by 11.3(W) x 11.3(H) x 1(T) cm^3,
; where W is width, H is height, and T is thickness
; One Aerogel detector is tiled by 2 x 4 x 5
; The final tune of geometry will be done by tracking association.
; Aerogel detector box is designed as 23.0(W) x 46.0(H) x 20.0(T) cm^3
; MK

     haer_width     = 22.6 
     haer_height    = 45.2
     haer_thickness =  5.0

     haer_slope = 2.0

     haer_npe_min = 0.5


#!/bin/sh

EXE/engine_replay grun=$1 $2 $3 $4 $5
if [ -e paw/hks$1.rzdat ]; then
    $ROOTSYS/bin/h2root paw/hks$1.rzdat rootfiles/hks$1.root
fi

if [ -e paw/hdc$1.rzdat ]; then
    $ROOTSYS/bin/h2root paw/hdc$1.rzdat rootfiles/hdc$1.root
fi

if [ -e paw/htrack$1.rzdat ]; then
    $ROOTSYS/bin/h2root paw/htrack$1.rzdat rootfiles/htrack$1.root
fi

if [ -e paw/coin$1.rzdat ]; then
    $ROOTSYS/bin/h2root paw/coin$1.rzdat rootfiles/coin$1.root
fi
*     Revision 1.1  1994/04/13  19:01:46  cdaq
*     Initial revision
*     
*     The following include statments must precede the inclusion of this
*     file in each routine that uses it.  The *%% syntax is also a
*     directive to makereg to tell it to include the code in the program
*     that it generates.
*     
*%%   include 'hks_data_structures.cmn'
*%%   include 'hks_scin_parms.cmn'
*     
*     CTPTYPE=event
*     
      real*4 hscin_long_coord(hmax_scin_hits)
      real*4 hscin_trans_coord(hmax_scin_hits)
      real*4 hscin_pos_coord(hmax_scin_hits)
      real*4 hscin_neg_coord(hmax_scin_hits)

      real*4 hscin_pos_invadc_offset(hmax_scin_hits)
      real*4 hscin_neg_invadc_offset(hmax_scin_hits)
      real*4 hscin_pos_invadc_linear(hmax_scin_hits)
      real*4 hscin_neg_invadc_linear(hmax_scin_hits)
      real*4 hscin_pos_invadc_adc(hmax_scin_hits)
      real*4 hscin_neg_invadc_adc(hmax_scin_hits)	

*     
*     CTPTYPE=parm
*     
      real*4 hscin_adc_min
      real*4 hscin_adc_max
      real*4 hscin_tdc_min
      real*4 hscin_tdc_max
      real*4 hscin_tdc_to_time
      real*4 hstart_time_center
      real*4 h1start_time_center  
      real*4 h2start_time_center
      real*4 htof_tolerance        ! tolerance for tof window in nsec
      Integer hdumptof
*     ! center of time window on scin. hits
      real*4 hstart_time_slop      
*     ! 1/2 width of time window on scin. hits
      
*     
*     CTPTYPE=event
*     
      logical*4 hgood_pos(hmax_scin_hits)
      logical*4 hgood_neg(hmax_scin_hits)
      logical*4 hgood_tdc_pos(hntracks_max,hmax_scin_hits)
      logical*4 hgood_tdc_neg(hntracks_max,hmax_scin_hits)

      Integer*4 hscin_on_track(hntracks_max,hnum_scin_layers)
      Integer*4 hscin_on_track2(hntracks_max,hnum_scin_layers)
      real*4 hscin_trk_good(hntracks_max,hnum_scin_layers)
      real*4 hscin_trk_depo(hntracks_max,hnum_scin_layers)
      real*4 hscin_trk_time(hntracks_max,hnum_scin_layers)
      real*4 hscin_trk_depo2(hntracks_max,hnum_scin_layers)
      real*4 hscin_trk_time2(hntracks_max,hnum_scin_layers)
      real*4 hscin_trk_diff(hntracks_max,hnum_scin_layers)
      real*4 hscin_trk_fptime(hntracks_max,hnum_scin_layers)
      Integer*4 hpro_counter_num(hmax_scin_hits,hnum_scin_layers)
      real*4 hstart_pro(hmax_scin_hits,hnum_scin_layers)
   
      real*4 htrk_tof(hntracks_max)
      real*4 htrk_leng(hntracks_max)
      real*4 htrk_beta(hntracks_max)
      real*4 htrk_beta1y(hntracks_max)
      real*4 htrk_depo(hntracks_max)
      Integer*4 htrk_id(hntracks_max)
            
      common/hks_scin_tof/
     &     hscin_on_track,             
     &     hscin_on_track2,             
     &     hscin_long_coord,
     &     hscin_trans_coord,
     &     hscin_pos_coord,hscin_neg_coord,
     &     hscin_adc_min,
     &     hscin_adc_max,
     &     hscin_tdc_min,
     &     hscin_tdc_max,
     &     hscin_tdc_to_time,
     &     hgood_tdc_pos, hgood_tdc_neg, 
     &     hgood_pos, hgood_neg, 
     &     hscin_trk_good,
     &     hscin_trk_depo,
     &     hscin_trk_time,
     &     hscin_trk_depo2,
     &     hscin_trk_time2,
     &     hscin_trk_diff,
     &     hscin_trk_fptime,            
     &     htrk_tof,
     &     htrk_leng,
     &     htrk_beta,
     &     htrk_beta1y,
     &     htrk_depo,
     &     htrk_id,
     &     hstart_time_center,
     &     h1start_time_center,
     &     h2start_time_center,
     &     hstart_time_slop,
     &     hdumptof, 
     &     htof_tolerance,
     >     hscin_pos_invadc_offset,
     >     hscin_neg_invadc_offset,
     >     hscin_pos_invadc_linear,
     >     hscin_neg_invadc_linear,
     >     hscin_pos_invadc_adc,
     >     hscin_neg_invadc_adc,
     >     hpro_counter_num,
     >     hstart_pro
    

*     
*     CTPTYPE=event
*

      real*4 hbeta_notrk
      real*4 hbeta_chisq_notrk
      real*4 hbeta_p
      real*4 hbeta_pcent
      
      common/htof_notrk/
     &     hbeta_notrk,
     &     hbeta_chisq_notrk,
     &     hbeta_p,
     &     hbeta_pcent
      

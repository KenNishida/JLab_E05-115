      integer*4 hwat_neg_ped_limit(HNUM_WAT_LAYERS,HNUM_WAT_COUNTERS)
*


*        hwat_pos_ped_sum2,       !sum of squares
*        hwat_neg_ped_sum2,       !sum of squares
*        hwat_pos_ped_sum,        !sum of peds
*        hwat_neg_ped_sum,        !sum of peds
*        hwat_pos_ped_num,        !number of peds
*        hwat_neg_ped_num,        !number of peds
*        hwat_pos_ped_limit,  
*     max. allowed ped (reject hits during ped trig)
*        hwat_neg_ped_limit,      !max. allowed ped
*        hwat_min_peds,           
*     # of peds required to override default pedestals
*        hwat_pos_ped_mean,       !calculated pedestal value
*        hwat_pos_ped_rms,        !calculated pedestal width

      common/hks_water_pedestals/
     &   hwat_pos_ped_sum2,       
     &   hwat_neg_ped_sum2,       
     &   hwat_pos_ped_sum,       
     &   hwat_neg_ped_sum,       
     &   hwat_pos_ped_num,       
     &   hwat_neg_ped_num,       
     &   hwat_pos_ped_limit,      
     &   hwat_neg_ped_limit,     
     &   hwat_min_peds,     
     &   hwat_num_ped_changes,	
     &   hwat_changed_layer,
     &   hwat_changed_element,
     &   hwat_changed_sign,
     &   hwat_ped_change,
     &   hwat_new_sig_pos,
     &   hwat_new_sig_neg,
     &   hwat_new_ped_pos,
     &   hwat_new_ped_neg,
     &   hwat_pos_ped_mean,  
     &   hwat_neg_ped_mean,
     &   hwat_pos_ped_rms,       
     &   hwat_neg_ped_rms,
     &   hwat_pos_threshold,
     &   hwat_neg_threshold,
     &   hwat_pos_adc_threshold,
     &   hwat_neg_adc_threshold

*
*
* LUCITE CERENKOV PEDESTALS
*
*
*     CTPTYPE=event
*
      integer*4 hluc_pos_ped_sum2(HNUM_LUC_LAYERS,HNUM_LUC_COUNTERS)
      integer*4 hluc_neg_ped_sum2(HNUM_LUC_LAYERS,HNUM_LUC_COUNTERS)
      integer*4 hluc_tot_ped_sum2(HNUM_LUC_LAYERS,HNUM_LUC_COUNTERS)
      integer*4 hluc_pos_ped_sum(HNUM_LUC_LAYERS,HNUM_LUC_COUNTERS)
      integer*4 hluc_neg_ped_sum(HNUM_LUC_LAYERS,HNUM_LUC_COUNTERS)
      integer*4 hluc_tot_ped_sum(HNUM_LUC_LAYERS,HNUM_LUC_COUNTERS)
      integer*4 hluc_pos_ped_num(HNUM_LUC_LAYERS,HNUM_LUC_COUNTERS)
      integer*4 hluc_neg_ped_num(HNUM_LUC_LAYERS,HNUM_LUC_COUNTERS)
      integer*4 hluc_tot_ped_num(HNUM_LUC_LAYERS,HNUM_LUC_COUNTERS)

      integer*4 hluc_num_ped_changes	
      integer*4 hluc_changed_layer(2*hmax_luc_hits)
      integer*4 hluc_changed_element(2*hmax_luc_hits)
      integer*4 hluc_changed_sign(2*hmax_luc_hits)
      real*4 hluc_ped_change(2*hmax_luc_hits)

      real*4 hluc_new_sig_pos(hnum_luc_layers,hnum_luc_counters)
      real*4 hluc_new_sig_neg(hnum_luc_layers,hnum_luc_counters)
      real*4 hluc_new_sig_tot(hnum_luc_layers,hnum_luc_counters)
      real*4 hluc_new_ped_pos(hnum_luc_layers,hnum_luc_counters)
      real*4 hluc_new_ped_neg(hnum_luc_layers,hnum_luc_counters)
      real*4 hluc_new_ped_tot(hnum_luc_layers,hnum_luc_counters)

*
*     CTPTYPE=parm
*
      integer*4 hluc_min_peds
      real*4 hluc_pos_ped_mean(HNUM_LUC_LAYERS,HNUM_LUC_COUNTERS)
      real*4 hluc_neg_ped_mean(HNUM_LUC_LAYERS,HNUM_LUC_COUNTERS)
      real*4 hluc_tot_ped_mean(HNUM_LUC_LAYERS,HNUM_LUC_COUNTERS)	
      real*4 hluc_pos_ped_rms(HNUM_LUC_LAYERS,HNUM_LUC_COUNTERS)
      real*4 hluc_neg_ped_rms(HNUM_LUC_LAYERS,HNUM_LUC_COUNTERS)
      real*4 hluc_tot_ped_rms(HNUM_LUC_LAYERS,HNUM_LUC_COUNTERS)
      real*4 hluc_pos_threshold(HNUM_LUC_LAYERS,HNUM_LUC_COUNTERS)
      real*4 hluc_neg_threshold(HNUM_LUC_LAYERS,HNUM_LUC_COUNTERS)
      real*4 hluc_tot_threshold(HNUM_LUC_LAYERS,HNUM_LUC_COUNTERS)
      integer*4 hluc_pos_adc_threshold(HNUM_LUC_LAYERS,HNUM_LUC_COUNTERS)
      integer*4 hluc_neg_adc_threshold(HNUM_LUC_LAYERS,HNUM_LUC_COUNTERS)
      integer*4 hluc_tot_adc_threshold(HNUM_LUC_LAYERS,HNUM_LUC_COUNTERS)
      integer*4 hluc_pos_ped_limit(HNUM_LUC_LAYERS,HNUM_LUC_COUNTERS)
      integer*4 hluc_neg_ped_limit(HNUM_LUC_LAYERS,HNUM_LUC_COUNTERS)
      integer*4 hluc_tot_ped_limit(HNUM_LUC_LAYERS,HNUM_LUC_COUNTERS)
*


*        hluc_pos_ped_sum2,       !sum of squares
*        hluc_neg_ped_sum2,       !sum of squares
*        hluc_tot_ped_sum2,       !sum of squares
*        hluc_pos_ped_sum,        !sum of peds
*        hluc_neg_ped_sum,        !sum of peds
*        hluc_tot_ped_sum,        !sum of peds
*        hluc_pos_ped_num,        !number of peds
*        hluc_neg_ped_num,        !number of peds
*        hluc_tot_ped_num,        !number of peds
*        hluc_pos_ped_limit,  
*     max. allowed ped (reject hits during ped trig)
*        hluc_neg_ped_limit,      !max. allowed ped
*        hluc_tot_ped_limit,
*        hluc_min_peds,           
*     # of peds required to override default pedestals
*        hluc_pos_ped_mean,       !calculated pedestal value
*        hluc_pos_ped_rms,        !calculated pedestal width

      common/hks_lucite_pedestals/
     &   hluc_pos_ped_sum2,       
     &   hluc_neg_ped_sum2,    
     &   hluc_tot_ped_sum2,    
     &   hluc_pos_ped_sum,       
     &   hluc_neg_ped_sum,
     &   hluc_tot_ped_sum,
     &   hluc_pos_ped_num,       
     &   hluc_neg_ped_num,   
     &   hluc_tot_ped_num,   
     &   hluc_pos_ped_limit,      
     &   hluc_neg_ped_limit,
     &   hluc_tot_ped_limit,
     &   hluc_min_peds,     
     &   hluc_num_ped_changes,	
     &   hluc_changed_layer,
     &   hluc_changed_element,
     &   hluc_changed_sign,
     &   hluc_ped_change,
     &   hluc_new_sig_pos,
     &   hluc_new_sig_neg,
     &   hluc_new_sig_tot,
     &   hluc_new_ped_pos,
     &   hluc_new_ped_neg,
     &   hluc_new_ped_tot,
     &   hluc_pos_ped_mean,  
     &   hluc_neg_ped_mean,
     &   hluc_tot_ped_mean,
     &   hluc_pos_ped_rms,       
     &   hluc_neg_ped_rms,
     &   hluc_tot_ped_rms,
     &   hluc_pos_threshold,
     &   hluc_neg_threshold,
     &   hluc_tot_threshold,
     &   hluc_pos_adc_threshold,
     &   hluc_neg_adc_threshold,
     &   hluc_tot_adc_threshold
*
*     CTPTYPE=event
*
      real*4 hscin_new_threshold_pos(hnum_scin_layers,hnum_scin_elements)
      real*4 hscin_new_threshold_neg(hnum_scin_layers,hnum_scin_elements)
      real*4 haer_new_threshold_pos(hnum_aer_layers,hnum_aer_counters)
      real*4 haer_new_threshold_neg(hnum_aer_layers,hnum_aer_counters)
      real*4 hwat_new_threshold_pos(hnum_wat_layers,hnum_wat_counters)
      real*4 hwat_new_threshold_neg(hnum_wat_layers,hnum_wat_counters)
      real*4 hluc_new_threshold_pos(hnum_luc_layers,hnum_luc_counters)
      real*4 hluc_new_threshold_neg(hnum_luc_layers,hnum_luc_counters)
      real*4 hluc_new_threshold_tot(hnum_luc_layers,hnum_luc_counters)


*
      common/hks_adc_thresholds/
     &   hscin_new_threshold_pos,
     &   hscin_new_threshold_neg,
     &   haer_new_threshold_pos,
     &   haer_new_threshold_neg,
     &   hwat_new_threshold_pos,
     &   hwat_new_threshold_neg,
     &   hluc_new_threshold_pos,
     &   hluc_new_threshold_neg,
     &   hluc_new_threshold_tot


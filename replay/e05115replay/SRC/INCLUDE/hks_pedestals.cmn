*
*     The following include statments must precede the inclusion of this
*     file in each routine that uses it.  The *%% syntax is also a
*     directive to makereg to tell it to include the code in the program
*     that it generates.
*
*%%   include 'hks_data_structures.cmn'
*
*     CTPTYPE=event
*
*
* HODOSCOPE PEDESTALS
*
      integer*4 hscin_pos_ped_sum2(hnum_scin_layers,hnum_scin_elements)
      integer*4 hscin_neg_ped_sum2(hnum_scin_layers,hnum_scin_elements)
      integer*4 hscin_pos_ped_sum(hnum_scin_layers,hnum_scin_elements)
      integer*4 hscin_neg_ped_sum(hnum_scin_layers,hnum_scin_elements)
      integer*4 hscin_pos_ped_num(hnum_scin_layers,hnum_scin_elements)
      integer*4 hscin_neg_ped_num(hnum_scin_layers,hnum_scin_elements)
      integer*4 hscin_num_ped_changes
      integer*4 hscin_changed_layer(2*hmax_raw_scin_hits)
      integer*4 hscin_changed_element(2*hmax_raw_scin_hits)
      integer*4 hscin_changed_sign(2*hmax_raw_scin_hits)
      real*4 hscin_ped_change(2*hmax_raw_scin_hits)
      real*4 hscin_new_sig_pos(hnum_scin_layers,hnum_scin_elements)
      real*4 hscin_new_sig_neg(hnum_scin_layers,hnum_scin_elements)
      real*4 hscin_new_ped_pos(hnum_scin_layers,hnum_scin_elements)
      real*4 hscin_new_ped_neg(hnum_scin_layers,hnum_scin_elements)
*
*     CTPTYPE=parm
*
      integer*4 hscin_min_peds
      integer*4 hscin_pos_ped_limit(hnum_scin_layers,hnum_scin_elements)
      integer*4 hscin_neg_ped_limit(hnum_scin_layers,hnum_scin_elements)
*

*     hscin_pos_ped_sum2   !sum of squares
*     hscin_neg_ped_sum2   !sum of squares
*     hscin_pos_ped_sum    !sum of peds
*     hscin_neg_ped_sum    !sum of peds
*     hscin_pos_ped_num    !number of peds
*     hscin_neg_ped_num    !number of peds
*     hscin_pos_ped_limit  !max. allowed ped (reject hits during ped trig)
*     hscin_neg_ped_limit  !max. allowed ped
*     hscin_min_peds       !# of peds required to override default pedestals
*     hscin_num_ped_changes!# of peds with 2 sigma change from param file.
*     hscin_changed_sign   !1=pos,2=neg


      common/hks_scin_pedestals/
     &   hscin_pos_ped_sum2,
     &   hscin_neg_ped_sum2,
     &   hscin_pos_ped_sum,
     &   hscin_neg_ped_sum,
     &   hscin_pos_ped_num,
     &   hscin_neg_ped_num,
     &   hscin_pos_ped_limit,
     &   hscin_neg_ped_limit,
     &   hscin_min_peds,
     &   hscin_new_sig_pos,
     &   hscin_new_sig_neg,
     &   hscin_new_ped_pos,
     &   hscin_new_ped_neg,
     &   hscin_num_ped_changes,
     &   hscin_changed_layer,
     &   hscin_changed_element,
     &   hscin_changed_sign,
     &   hscin_ped_change
*
*
* AEROGEL CERENKOV PEDESTALS
* replace haer_ped_mean with float(haer_ped_sum/haer_ped_num),
*         haer_ped_rms  with (appropriate formula),
*    and  haer_threshold with (something like) min(10.,3.*haer_ped_rms)
*         haer_ped_rms  with (appropriate formula),if haer_num > haer_min_peds.
*
*
*     CTPTYPE=event
*
      integer*4 haer_pos_ped_sum2(HNUM_AER_LAYERS,HNUM_AER_COUNTERS)
      integer*4 haer_neg_ped_sum2(HNUM_AER_LAYERS,HNUM_AER_COUNTERS)
      integer*4 haer_pos_ped_sum(HNUM_AER_LAYERS,HNUM_AER_COUNTERS)
      integer*4 haer_neg_ped_sum(HNUM_AER_LAYERS,HNUM_AER_COUNTERS)
      integer*4 haer_pos_ped_num(HNUM_AER_LAYERS,HNUM_AER_COUNTERS)
      integer*4 haer_neg_ped_num(HNUM_AER_LAYERS,HNUM_AER_COUNTERS)

      integer*4 haer_num_ped_changes	
      integer*4 haer_changed_layer(2*hmax_aer_hits)
      integer*4 haer_changed_element(2*hmax_aer_hits)
      integer*4 haer_changed_sign(2*hmax_aer_hits)
      real*4 haer_ped_change(2*hmax_aer_hits)

      real*4 haer_new_sig_pos(hnum_aer_layers,hnum_aer_counters)
      real*4 haer_new_sig_neg(hnum_aer_layers,hnum_aer_counters)
      real*4 haer_new_ped_pos(hnum_aer_layers,hnum_aer_counters)
      real*4 haer_new_ped_neg(hnum_aer_layers,hnum_aer_counters)

*
*     CTPTYPE=parm
*
      integer*4 haer_min_peds
      real*4 haer_pos_ped_mean(HNUM_AER_LAYERS,HNUM_AER_COUNTERS)
      real*4 haer_neg_ped_mean(HNUM_AER_LAYERS,HNUM_AER_COUNTERS)
      real*4 haer_pos_ped_rms(HNUM_AER_LAYERS,HNUM_AER_COUNTERS)
      real*4 haer_neg_ped_rms(HNUM_AER_LAYERS,HNUM_AER_COUNTERS)
      real*4 haer_pos_threshold(HNUM_AER_LAYERS,HNUM_AER_COUNTERS)
      real*4 haer_neg_threshold(HNUM_AER_LAYERS,HNUM_AER_COUNTERS)
      integer*4 haer_pos_adc_threshold(HNUM_AER_LAYERS,HNUM_AER_COUNTERS)
      integer*4 haer_neg_adc_threshold(HNUM_AER_LAYERS,HNUM_AER_COUNTERS)
      integer*4 haer_pos_ped_limit(HNUM_AER_LAYERS,HNUM_AER_COUNTERS)
      integer*4 haer_neg_ped_limit(HNUM_AER_LAYERS,HNUM_AER_COUNTERS)

*
*   haer_pos_ped_sum2,     sum of squares
*   haer_neg_ped_sum2,     sum of squares
*   haer_pos_ped_sum,      sum of peds
*   haer_neg_ped_sum,      sum of peds
*   haer_pos_ped_num,      number of peds
*   haer_neg_ped_num,      number of peds
*   haer_pos_ped_limit,    max. allowed ped (reject hits during ped trig)
*   haer_neg_ped_limit,    max. allowed ped
*   haer_min_peds,         # of peds required to override default pedestals
*   haer_pos_ped_mean,     calculated pedestal value
*   haer_neg_ped_mean,
*   haer_pos_ped_rms,      calculated pedestal width

      common/hks_aero_pedestals/
     &   haer_pos_ped_sum2,       
     &   haer_neg_ped_sum2,     
     &   haer_pos_ped_sum,       
     &   haer_neg_ped_sum,       
     &   haer_pos_ped_num,       
     &   haer_neg_ped_num,       
     &   haer_pos_ped_limit,     
     &   haer_neg_ped_limit,  
     &   haer_min_peds,       
     &   haer_num_ped_changes,	
     &   haer_changed_layer,
     &   haer_changed_element,
     &   haer_changed_sign,
     &   haer_ped_change,
     &   haer_new_sig_pos,
     &   haer_new_sig_neg,
     &   haer_new_ped_pos,
     &   haer_new_ped_neg,
     &   haer_pos_ped_mean,    
     &   haer_neg_ped_mean,
     &   haer_pos_ped_rms,      
     &   haer_neg_ped_rms,
     &   haer_pos_threshold,
     &   haer_neg_threshold,
     &   haer_pos_adc_threshold,
     &   haer_neg_adc_threshold


*
*
* WATER CERENKOV PEDESTALS

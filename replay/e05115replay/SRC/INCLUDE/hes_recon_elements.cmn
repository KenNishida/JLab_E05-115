*     CTPTYPE=parm
*
      integer*4        emax_recon_elements
      parameter       (emax_recon_elements = 1000) 
      integer*4        emax_t2s_elements
      parameter       (emax_t2s_elements = 500) 
*!Max # coeff elements

      real*4           e_recon_coeff(4,emax_recon_elements)
      real*4           e_ang_slope_x,e_ang_slope_y
      real*4           e_ang_offset_x,e_ang_offset_y
      real*4           e_det_offset_x,e_det_offset_y
      real*4           e_z_true_focus 
*! Z position of HKS focus
      integer*4        e_recon_expon(5,emax_recon_elements)
      integer*4        e_num_recon_terms
      integer*4        e_recon_initted
*	Target to Sieve Slit transter matrix      
      integer*4        e_num_t2s_terms	
      integer*4        e_t2s_initted
      integer*4        e_t2s_expon(3,emax_t2s_elements)
      real*4           e_t2s_coeff(2,emax_t2s_elements)
		real*4           Center_of_efp(4)
		real*4           Nfactor_of_efp(4)
		real*4           Center_of_etar(4)
		real*4           Nfactor_of_etar(4)
*
*     e_recon_initted,             !Initialization flag.
*     e_num_recon_terms,           !Number of terms.
*     e_recon_coeff,               !Coefficients.
*     e_recon_expon,               !Exponents.
*     e_ang_slope_x, e_ang_slope_y,   ! Slopes for rotation of f plane
*     e_ang_offset_x, e_ang_offset_y, ! Slopes for rotation of f plane
*     e_det_offset_x,e_det_offset_y,  ! Detector offsets
*     e_z_true_focus               ! Z position of HKS focus


      common /hes_recon_elements/
     >     e_num_recon_terms,          
     >     e_recon_initted,          
     >     e_num_t2s_terms,          
     >     e_recon_coeff,             
     >     e_recon_expon,              
     >     e_ang_slope_x, e_ang_slope_y,   
     >     e_ang_offset_x, e_ang_offset_y,
     >     e_det_offset_x,e_det_offset_y, 
     >     e_z_true_focus,          
     >     e_t2s_initted,            ! Target to SV matrix            
     >     e_t2s_coeff,             
     >     e_t2s_expon,               
     >	  Center_of_efp,
     >	  Nfactor_of_efp,
     >	  Center_of_etar,
     >	  Nfactor_of_etar

*********************************************************************



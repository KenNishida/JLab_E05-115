*
*     The following include statments must precede the inclusion of this
*     file in each routine that uses it.  The *%% syntax is also a
*     directive to makereg to tell it to include the code in the program
*     that it generates.
*
*%%   include 'hks_data_structures.cmn'

*
*     CTPTYPE=parm
*
      real*4 hstat_maxchisq
      real*4 hstat_slop
      real*4 hstat_mineff
*
*     CTPTYPE=event
*
      integer*4 hstat_numevents
      integer*4 hstat_trk(hnum_scin_layers,hnum_scin_elements)
      integer*4 hstat_poshit(hnum_scin_layers,hnum_scin_elements)
      integer*4 hstat_neghit(hnum_scin_layers,hnum_scin_elements)
      integer*4 hstat_orhit(hnum_scin_layers,hnum_scin_elements)
      integer*4 hstat_andhit(hnum_scin_layers,hnum_scin_elements)
      integer*4 hstat_trksum(hnum_scin_layers)
      integer*4 hstat_possum(hnum_scin_layers)
      integer*4 hstat_negsum(hnum_scin_layers)
      integer*4 hstat_orsum(hnum_scin_layers)
      integer*4 hstat_andsum(hnum_scin_layers)
      real*4 hstat_peff(hnum_scin_layers,hnum_scin_elements)
      real*4 hstat_neff(hnum_scin_layers,hnum_scin_elements)
      real*4 hstat_oeff(hnum_scin_layers,hnum_scin_elements)
      real*4 hstat_aeff(hnum_scin_layers,hnum_scin_elements)
      real*4 hstat_poseff(hnum_scin_layers)
      real*4 hstat_negeff(hnum_scin_layers)
      real*4 hstat_oreff(hnum_scin_layers)
      real*4 hstat_andeff(hnum_scin_layers)
      real*4 heff_h1
      real*4 heff_h2
      real*4 heff_htof
      real*4 heff_3_of_3


*       hstat_trk,         !# of times track points near center of scin.
*       hstat_poshit,      !# of times the pos tube on scintillator fired
*       hstat_neghit,      !# of times the pos tube on scintillator fired
*       hstat_orhit,       !# of times either tube fired
*       hstat_andhit,      !# of times both tubes fired
*       hstat_trksum,      !summed over all counters on layer
*       hstat_possum,      !summed over all counters on layer
*       hstat_negsum,      !summed over all counters on layer
*       hstat_orsum,       !summed over all counters on layer
*       hstat_andsum,      !summed over all counters on layer
*       hstat_peff,        !pos efficiency for given counter.
*       hstat_neff,        !neg efficiency for given counter.
*       hstat_oeff,        !or  efficiency for given counter.
*       hstat_aeff,        !and efficiency for given counter.
*       hstat_poseff,      !efficiency over all counters on layer
*       hstat_negeff,      !efficiency over all counters on layer
*       hstat_oreff,       !efficiency over all counters on layer
*       hstat_andeff,      !efficiency over all counters on layer
*       hstat_slop,        !distance allowed from center of scintillator.
*       hstat_mineff,      !give warning if effic. < hstat_mineff
*       hstat_maxchisq,    !maximum chisq allowed to use track for eff. calc.
*       seff_s1,           !calculated trigger eff. for s1 =(s1x .or. s1y).
*       seff_s2,           !calculated trigger eff. for s2 =(s2x .or. s2y).
*       seff_stof,         !calculated trigger eff. for stof =(s1 .and. s2).

      common/sscin_statistics/
     &  hstat_numevents,
     &  hstat_trk,        
     &  hstat_poshit,     
     &  hstat_neghit,     
     &  hstat_orhit,      
     &  hstat_andhit,     
     &  hstat_trksum,      
     &  hstat_possum,      
     &  hstat_negsum,      
     &  hstat_orsum,      
     &  hstat_andsum,     
     &  hstat_peff,       
     &  hstat_neff,       
     &  hstat_oeff,        
     &  hstat_aeff,        
     &  hstat_poseff,      
     &  hstat_negeff,      
     &  hstat_oreff,       
     &  hstat_andeff,      
     &  hstat_slop,        
     &  hstat_mineff,     
     &  hstat_maxchisq,    
     &  heff_h1,          
     &  heff_h2,          
     &  heff_htof,         
     &  heff_3_of_3


*
*     CTPTYPE=event
*
      integer hbothgood(hnum_scin_layers,hnum_scin_elements)
      integer hposgood(hnum_scin_layers,hnum_scin_elements)
      integer hneggood(hnum_scin_layers,hnum_scin_elements)

      common/hscin_posneg_stats/
     &   hbothgood,
     &   hposgood,
     &   hneggood
*
*     CTPTYPE=parm
*
      real*4 hdc_min_eff(hmax_num_dc_layers)   
*!''warning'' value for layer eff.
*
*     CTPTYPE=event
*
      integer*4 hdc_tot_events                 
*!total number of events examined
      integer*4 hdc_events(hmax_num_dc_layers) 
*!counter of times layer was hit
      integer*4 hdc_cham_hits(hmax_num_chambers)
      real*4 hdc_layer_eff(hmax_num_dc_layers) 
*!effic=events(pln)/tot_events
      real*4 hdc_cham_eff(hmax_num_chambers)

      common/hdc_statistics/
     &   hdc_tot_events,
     &   hdc_events,
     &   hdc_min_eff,
     &   hdc_layer_eff,
     &   hdc_cham_hits,
     &   hdc_cham_eff


*%%     include "hes_data_structures.cmn"
*
*     CTPTYPE=event
*
*     initializiation paramters
      REAL*4  EPHYSICSA                 
*   Coefficients of p3 in elastic cal
      REAL*4  EPHYSICSB                 
      REAL*4  EPHYSICAB2                
      REAL*4  EPHYSICSM3B
* COS(ETHETA_LAB) and SIN(ETHETA_LAB)
      REAL*4  COSETHETAE 
      REAL*4  SINETHETAE                 

      COMMON/HES_PHYSICS_PARAM_R4/
     &     EPHYSICSA,
     &     EPHYSICSB,
     &     EPHYSICAB2,
     &     EPHYSICSM3B,
     &     COSETHETAE,
     &     SINETHETAE

*     
*     Parameters that select good tracks. Note these should be
*     loose cuts to make sure we select one track. The final 
*     tighter cuts should be made with tests.
*
      REAL*4 esel_chi2_fpperdegmax
*! Maximun chi2 per degree of freedom at the focal plane

      REAL*4 esel_dedx1min              
*! Minimum dedx in chamber 1
      REAL*4 esel_dedx1max              
*! Maximum dedx in chamber 1

      INTEGER*4 esel_ndegreesmin        
*! Minimum number of degrees of freedom
*     
      COMMON/hes_chose_one_track_r4/
     &     esel_chi2_fpperdegmax,
     &     esel_dedx1min,
     &     esel_dedx1max

*
      COMMON/hes_chose_one_track_i4/
     &     esel_ndegreesmin
      
*
*     CTPTYPE=event
*
      real*4 esx_dc1_layer1(ENPHYSICS_MAX)
      real*4 esy_dc1_layer1(ENPHYSICS_MAX)
      real*4 esx_s1(ENPHYSICS_MAX)
      real*4 esy_s1(ENPHYSICS_MAX)
      real*4 esx_s2(ENPHYSICS_MAX)
      real*4 esy_s2(ENPHYSICS_MAX)

      COMMON/hes_tmp_stuff/
     &     esx_dc1_layer1, esy_dc1_layer1,
     &     esx_s1, esy_s1,
     &     esx_s2, esy_s2

*
*     CTPTYPE=parm
*
      real*4 epathlength_central
*     - coeff up to 5th order
*     (x,y) x = xfp,yfp,xpfp,ypfp
*           y = 1st,2nd,3rd,4th,5th order
      real*4 epath_coeff(20)
*
*     CTPTYPE=event
*
      real*4 espathlength(ENPHYSICS_MAX)

      COMMON/hes_timing_stuff/
     &     epathlength_central,
     &     espathlength,
     &     epath_coeff

*
*     CTPTYPE=parm
*
c D.Dutta, 24th-Apr-1996

* hes delta offset
      real*4 edelta_offset     
* hes scattering angle offset
      real*4 etheta_offset     
      real*4 ephi_offset
*! multiplier for the hes momentum
      real*4 emomentum_factor  

      COMMON /hes_offsets/
     &     edelta_offset,
     &     etheta_offset,
     &     ephi_offset,
     &     emomentum_factor

*
*
*     CTPTYPE=event
*
      real*4 es_qvec(enphysics_max,4)   
      real*4 es_kpvec(enphysics_max,4) 
      real*4 es_kvec(enphysics_max,4)  
      real*4 es_tvec(enphysics_max,4)

      COMMON/es_vectors/
     &     es_qvec,
     &     es_kpvec,
     &     es_kvec,
     &     es_tvec

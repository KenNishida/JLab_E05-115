* Revision 1.1  1994/02/22  14:47:24  cdaq
* Initial revision
*                    
*     The following include statments must precede the inclusion of this
*     file in each routine that uses it.  The *%% syntax is also a
*     directive to makereg to tell it to include the code in the program
*     that it generates.
*
*%%   include 'hes_data_structures.cmn'
*
*     CTPTYPE=parm   
**     Probably don't really want the following registered

* number of layer track fit coefficients
      integer*4 ENUM_LAYER_COEFF   
      parameter (ENUM_LAYER_COEFF=9)
* number of ray parameters
      integer*4 ENUM_RAY_PARAM 
      parameter (ENUM_RAY_PARAM=4)
*

* geometrical coefficients defining z-z0, and 
* x and y for each wire layer. 
      real*4 edc1zchi(EMAX_NUM_DC1_LAYERS),edc1zpsi(EMAX_NUM_DC1_LAYERS)       
      real*4 edc1xchi(EMAX_NUM_DC1_LAYERS),edc1xpsi(EMAX_NUM_DC1_LAYERS)       
      real*4 edc1ychi(EMAX_NUM_DC1_LAYERS),edc1ypsi(EMAX_NUM_DC1_LAYERS)
      real*4 edc2zchi(EMAX_NUM_DC2_LAYERS),edc2zpsi(EMAX_NUM_DC2_LAYERS)       
      real*4 edc2xchi(EMAX_NUM_DC2_LAYERS),edc2xpsi(EMAX_NUM_DC2_LAYERS)       
      real*4 edc2ychi(EMAX_NUM_DC2_LAYERS),edc2ypsi(EMAX_NUM_DC2_LAYERS)

*z coordinate of intersection of chamber with z axis
      real*4 edc1z0(EMAX_NUM_DC1_LAYERS)               
      real*4 edc2z0(EMAX_NUM_DC2_LAYERS)               

* psi, chi and phi  coordinates  where a 
* chamber normal passing through the origin
* intersects the chamber. Used in stub fits
      real*4 edc1psi0(EMAX_NUM_DC1_LAYERS)
      real*4 edc1chi0(EMAX_NUM_DC1_LAYERS)
      real*4 edc1phi0(EMAX_NUM_DC1_LAYERS) 
      real*4 edc2psi0(EMAX_NUM_DC2_LAYERS)
      real*4 edc2chi0(EMAX_NUM_DC2_LAYERS)
      real*4 edc2phi0(EMAX_NUM_DC2_LAYERS) 

* coefficents used in stub fits note these contain one power of sigma
      real*4 edc1stubcoef(EMAX_NUM_DC1_LAYERS,ENUM_RAY_PARAM)         
      real*4 edc2stubcoef(EMAX_NUM_DC2_LAYERS,ENUM_RAY_PARAM)         

      real*4 edc1tanbeta(EMAX_NUM_DC1_LAYERS)
      real*4 edc1sinbeta(EMAX_NUM_DC1_LAYERS)
      real*4 edc1cosbeta(EMAX_NUM_DC1_LAYERS)
      real*4 edc2tanbeta(EMAX_NUM_DC2_LAYERS)
      real*4 edc2sinbeta(EMAX_NUM_DC2_LAYERS)
      real*4 edc2cosbeta(EMAX_NUM_DC2_LAYERS)

* coefficents used in space point fits.
      real*4 edc1xsp(EMAX_NUM_DC1_LAYERS)              
      real*4 edc1ysp(EMAX_NUM_DC1_LAYERS)
      real*4 edc2xsp(EMAX_NUM_DC2_LAYERS)              
      real*4 edc2ysp(EMAX_NUM_DC2_LAYERS)
* coefficients used in final track fit
      real*8 edc1layer_coeff(ENUM_LAYER_COEFF,EMAX_NUM_DC1_LAYERS)           
      real*8 edc2layer_coeff(ENUM_LAYER_COEFF,EMAX_NUM_DC2_LAYERS)           


      common/EDC1_GEOMETRY/
     &     edc1layer_coeff,
     &     edc1zpsi,edc1zchi,
     &     edc1xpsi,edc1xchi,
     &     edc1ypsi,edc1ychi,
     &     edc1z0,edc1psi0,edc1chi0,edc1phi0,
     &     edc1stubcoef,
     &     edc1xsp,edc1ysp,
     &     edc1tanbeta,edc1sinbeta,edc1cosbeta
      
		common/EDC2_GEOMETRY/
     &     edc2layer_coeff,
     &     edc2zpsi,edc2zchi,
     &     edc2xpsi,edc2xchi,
     &     edc2ypsi,edc2ychi,
     &     edc2z0,edc2psi0,edc2chi0,edc2phi0,
     &     edc2stubcoef,
     &     edc2xsp,edc2ysp,
     &     edc2tanbeta,edc2sinbeta,edc2cosbeta


      real*4  edc1_zpos(EMAX_NUM_DC1_LAYERS)
      real*4  edc1_alpha_angle(EMAX_NUM_DC1_LAYERS)
      real*4  edc1_beta_angle(EMAX_NUM_DC1_LAYERS)
      real*4  edc1_gamma_angle(EMAX_NUM_DC1_LAYERS)
      real*4  edc1_pitch(EMAX_NUM_DC1_LAYERS)
      real*4  edc1_central_wire(EMAX_NUM_DC1_LAYERS)
      real*4  edc1_sigma(EMAX_NUM_DC1_LAYERS)
      real*4  edc1_center(EMAX_NUM_DC1_LAYERS)
      real*4  edc1_length_x
      real*4  edc1_length_y	
*      real*4 ELAYER_PARAM
      integer*4 edc1_nrwire(EMAX_NUM_DC1_LAYERS)
      integer*4 edc1_chamber_layers(EMAX_NUM_DC1_LAYERS)
      character*16 edc1_layer_name(EMAX_NUM_DC1_LAYERS)

      common/EDC1_LAYER_PARAMETERS/
     &     edc1_zpos,
     &     edc1_alpha_angle,
     &     edc1_beta_angle,
     &     edc1_gamma_angle,
     &     edc1_pitch,
     &     edc1_central_wire,
     &     edc1_sigma,
     &     edc1_center,
     &	  edc1_length_x, 
     &     edc1_length_y,
     &     edc1_nrwire,
     &     edc1_chamber_layers,
     &     edc1_layer_name

      real*4  edc2_zpos(EMAX_NUM_DC2_LAYERS)
      real*4  edc2_alpha_angle(EMAX_NUM_DC2_LAYERS)
      real*4  edc2_beta_angle(EMAX_NUM_DC2_LAYERS)
      real*4  edc2_gamma_angle(EMAX_NUM_DC2_LAYERS)
      real*4  edc2_pitch(EMAX_NUM_DC2_LAYERS)
      real*4  edc2_central_wire(EMAX_NUM_DC2_LAYERS)
      real*4  edc2_sigma(EMAX_NUM_DC2_LAYERS)
      real*4  edc2_center(EMAX_NUM_DC2_LAYERS)
      real*4  edc2_length_x
      real*4  edc2_length_y	
*      real*4 ELAYER_PARAM
      integer*4 edc2_nrwire(EMAX_NUM_DC2_LAYERS)
      integer*4 edc2_chamber_layers(EMAX_NUM_DC2_LAYERS)
      character*16 edc2_layer_name(EMAX_NUM_DC2_LAYERS)

      common/EDC2_LAYER_PARAMETERS/
     &     edc2_zpos,
     &     edc2_alpha_angle,
     &     edc2_beta_angle,
     &     edc2_gamma_angle,
     &     edc2_pitch,
     &     edc2_central_wire,
     &     edc2_sigma,
     &     edc2_center,
     &	  edc2_length_x, 
     &     edc2_length_y,
     &     edc2_nrwire,
     &     edc2_chamber_layers,
     &     edc2_layer_name

      real*4 elocrayzt
      parameter (elocrayzt=0.)
*
*     CTPTYPE=parm
*
*     parameter file variables. Separate by type to make it easy to add
*     at the end
*     REAL*4
*
*      real*4 edrift_velocity        ! EDC1 drift velocity in cm/ns

      real*4 edc1_tdc_time_per_channel
      real*4 edc1_layer_time_zero(EMAX_NUM_DC1_SLOTS)
      real*4 edc2_tdc_time_per_channel
      real*4 edc2_layer_time_zero(EMAX_NUM_DC2_SLOTS)

      common/EDC1_READOUT_REAL/
*     &     edrift_velocity,
     &     edc1_tdc_time_per_channel,
     &     edc1_layer_time_zero

      common/EDC2_READOUT_REAL/
*     &     edrift_velocity,
     &     edc2_tdc_time_per_channel,
     &     edc2_layer_time_zero

*    INTEGER*4
*
      integer*4 edc1_wire_counting(EMAX_NUM_DC1_LAYERS)      
      integer*4 edc2_wire_counting(EMAX_NUM_DC2_LAYERS)      
*  readout numbering order
      common/EDC1_READOUT_INT/
     &     edc1_wire_counting
      common/EDC2_READOUT_INT/
     &     edc2_wire_counting


*
*     CTPTYPE=parm
*
*     WIRE OFFSET. EDC1 has wires not reading out.
*     All the wires which can be read out is counted.
*     For example, wire number at layer 1 starts from 3.
*
      INTEGER*4 EDC1_WIRE_OFFSET_LOW
      INTEGER*4 EDC1_WIRE_OFFSET_HIGH
 
      COMMON/HES_EDC1_WIRE_OFFSET/
     1     EDC1_WIRE_OFFSET_LOW(EMAX_NUM_DC1_LAYERS),
     2     EDC1_WIRE_OFFSET_HIGH(EMAX_NUM_DC1_LAYERS)
      
		INTEGER*4 EDC2_WIRE_OFFSET_LOW
      INTEGER*4 EDC2_WIRE_OFFSET_HIGH
 
      COMMON/HES_EDC2_WIRE_OFFSET/
     1     EDC2_WIRE_OFFSET_LOW(EMAX_NUM_DC2_LAYERS),
     2     EDC2_WIRE_OFFSET_HIGH(EMAX_NUM_DC2_LAYERS)
*                                                  

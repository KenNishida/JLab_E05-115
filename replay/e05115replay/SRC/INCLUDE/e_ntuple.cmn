      integer*4 EMAX_Ntuple_size
      parameter (EMAX_Ntuple_size= 100)
      integer*4 default_e_Ntuple_ID
      parameter (default_e_Ntuple_ID= 9010)
      integer*4 default_e_dc_Ntuple_ID
      parameter (default_e_dc_Ntuple_ID= 9011)
      integer*4 default_e_scin_Ntuple_ID
      parameter (default_e_scin_Ntuple_ID= 9012)
      integer*4 default_e_fis_Ntuple_ID
      parameter (default_e_fis_Ntuple_ID= 9013)
      integer*4 default_e_track_Ntuple_ID
      parameter (default_e_track_Ntuple_ID= 9014)
*
*     CTPTYPE=parm
*
      integer*4 e_Ntuple_ID
      integer*4 e_Ntuple_size
      integer*4 e_Ntuple_IOchannel

      integer*4 e_dc_ntuple_ID
      integer*4 e_dc_ntuple_size
      integer*4 e_dc_ntuple_IOchannel

      integer*4 e_scin_ntuple_ID
      integer*4 e_scin_ntuple_size
      integer*4 e_scin_ntuple_IOchannel

      integer*4 e_fis_ntuple_ID
      integer*4 e_fis_ntuple_size
      integer*4 e_fis_ntuple_IOchannel
      
		integer*4 e_track_ntuple_ID
      integer*4 e_track_ntuple_size
      integer*4 e_track_ntuple_IOchannel

      character*80 e_Ntuple_name
      character*80 e_Ntuple_title
      character*132 e_Ntuple_directory
      character*50 e_Ntuple_file
      character*8 e_Ntuple_tag(EMAX_Ntuple_size)

      character*80 e_dc_ntuple_name
      character*80 e_dc_ntuple_title
      character*132 e_dc_ntuple_directory
      character*50 e_dc_ntuple_file
      character*8 e_dc_ntuple_tag(EMAX_Ntuple_size)

      character*80 e_scin_ntuple_name
      character*80 e_scin_ntuple_title
      character*132 e_scin_ntuple_directory
      character*50 e_scin_ntuple_file
      character*8 e_scin_ntuple_tag(EMAX_Ntuple_size)

      character*80 e_fis_ntuple_name
      character*80 e_fis_ntuple_title
      character*132 e_fis_ntuple_directory
      character*50 e_fis_ntuple_file
      character*8 e_fis_ntuple_tag(EMAX_Ntuple_size)
      
		character*80 e_track_ntuple_name
      character*80 e_track_ntuple_title
      character*132 e_track_ntuple_directory
      character*50 e_track_ntuple_file
      character*8 e_track_ntuple_tag(EMAX_Ntuple_size)

      Common/HES_Ntuple_Par/
     &                e_Ntuple_tag,
     &                e_dc_ntuple_tag,
     &                e_scin_ntuple_tag,
     &                e_fis_ntuple_tag,
     &                e_track_ntuple_tag,
     &                e_Ntuple_directory,
     &                e_dc_ntuple_directory,
     &                e_scin_ntuple_directory,
     &                e_fis_ntuple_directory,
     &                e_track_ntuple_directory,
     &                e_Ntuple_ID,
     &                e_Ntuple_size,e_Ntuple_IOchannel,
     &                e_Ntuple_name,e_Ntuple_title,
     &                e_Ntuple_file,
     &                e_dc_Ntuple_ID,
     &                e_dc_ntuple_size,e_dc_ntuple_IOchannel,
     &                e_dc_ntuple_name,e_dc_ntuple_title,
     &                e_dc_ntuple_file,
     &                e_scin_Ntuple_ID,
     &                e_scin_ntuple_size,e_scin_ntuple_IOchannel,
     &                e_scin_ntuple_name,e_scin_ntuple_title,
     &                e_scin_ntuple_file,
     &                e_fis_Ntuple_ID,
     &                e_fis_ntuple_size,e_fis_ntuple_IOchannel,
     &                e_fis_ntuple_name,e_fis_ntuple_title,
     &                e_fis_ntuple_file,
     &                e_track_Ntuple_ID,
     &                e_track_ntuple_size,e_track_ntuple_IOchannel,
     &                e_track_ntuple_name,e_track_ntuple_title,
     &                e_track_ntuple_file

*
*     CTPTYPE=event
*
      real*4 e_Ntuple_contents(EMAX_Ntuple_size)
      real*4 e_dc_Ntuple_contents(EMAX_Ntuple_size)
      real*4 e_scin_Ntuple_contents(EMAX_Ntuple_size)
      real*4 e_fis_Ntuple_contents(EMAX_Ntuple_size)
      real*4 e_track_Ntuple_contents(EMAX_Ntuple_size)

*
      COMMON /HES_Ntuple/ 
     &         e_Ntuple_contents,
     &         e_dc_ntuple_contents,
     &         e_scin_ntuple_contents,
     &         e_fis_ntuple_contents,
     &         e_track_ntuple_contents

      logical e_Ntuple_exists
      logical e_dc_Ntuple_exists
      logical e_scin_Ntuple_exists
      logical e_fis_Ntuple_exists
      logical e_track_Ntuple_exists

      Common/HES_ntuple_logical/
     &                     e_Ntuple_exists,
     &                     e_dc_ntuple_exists,
     &                     e_scin_ntuple_exists,
     &                     e_fis_ntuple_exists,
     &                     e_track_ntuple_exists

*
